@@ -3268,6 +3271,80 @@ catch (sycl::exception const &exc) {
 static constexpr int64_t SYCL_F32_DNNL_MIN_GEMM_FLOPS = 256 * 256 * 256;
 #endif
 
+#if GGML_SYCL_DNNL && defined(GGML_SYCL_F16)
+// [rows][k / 32] -> [k / 32][rows]: the d plane of the Q8_0 reorder layout in the order oneDNN takes grouped
+// weight scales. 2 bytes per 32 weights, 1/32 of what dequantizing the weights to f16 writes.
+static void q8_0_reorder_scales_to_kn(const sycl::half * d, sycl::half * out, int64_t rows, int64_t groups,
+                                      const queue_ptr & stream) {
+    stream->parallel_for(sycl::range<2>(groups, rows), [=](sycl::id<2> id) {
+        out[id[0] * rows + id[1]] = d[id[1] * groups + id[0]];
+    });
+}
+
+// GGML_SYCL_WOQ_Q8_0 (candidate C80): Q8_0 prompt batches through oneDNN's weight-only-quantized matmul on the
+// reorder layout instead of dequantize + GEMM. 1 = the batches the fused XMX dequant GEMM declines (wider than
+// GGML_SYCL_FG_MAX_N), 2 = ahead of that GEMM too. Declines into the existing paths; after one decline (oneDNN
+// rejects the descriptor or offers only its reference implementation) it stays off for the process.
+static std::atomic<bool> g_ggml_sycl_woq_q8_0_declined{ false };
+
+static bool ggml_sycl_woq_q8_0_possible(int device) {
+    return g_ggml_sycl_woq_q8_0 != 0 && !g_ggml_sycl_woq_q8_0_declined.load(std::memory_order_relaxed) &&
+           g_ggml_sycl_enable_dnn && ggml_sycl_dnnl_has_optimized_gemm(device);
+}
+
+static bool ggml_sycl_woq_q8_0(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1,
+                               ggml_tensor * dst, const char * src0_dd_i, const float * src1_ddf_i,
+                               float * dst_dd_i, int64_t row_diff, int64_t src1_ncols, int ldc,
+                               const queue_ptr & stream) {
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    const int64_t ne00 = src0->ne[0];
+    if (!ggml_sycl_woq_q8_0_possible(ggml_sycl_get_device()) || src0->type != GGML_TYPE_Q8_0 || !extra ||
+        !extra->optimized_feature.reorder || !ggml_is_contiguous(src0) || src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        row_diff != src0->ne[1] || ne00 % QK8_0 != 0 || dst->op_params[0] != GGML_PREC_DEFAULT ||
+        !ggml_sycl_src1_f16_ok(dst) || (src1->type != GGML_TYPE_F32 && src1->type != GGML_TYPE_F16)) {
+        return false;
+    }
+
+    ggml_sycl_pool_alloc<sycl::half> src1_as_f16(ctx.pool());
+    const sycl::half * src1_ptr = (const sycl::half *) src1_ddf_i;
+    if (src1->type != GGML_TYPE_F16) {
+        const to_fp16_sycl_t to_fp16_sycl = ggml_get_to_fp16_sycl(src1->type, dst);
+        GGML_ASSERT(to_fp16_sycl != nullptr);
+        src1_as_f16.alloc(src1_ncols * ne00);
+        to_fp16_sycl(src1_ddf_i, src1_as_f16.get(), src1_ncols * ne00, stream);
+        src1_ptr = src1_as_f16.get();
+    }
+
+    // reorder layout: [row_diff * ne00 int8 qs][row_diff * ne00 / 32 f16 d]
+    const int64_t groups = ne00 / QK8_0;
+    const auto *  qs     = (const int8_t *) src0_dd_i;
+    const auto *  d      = (const sycl::half *) (src0_dd_i + row_diff * ne00);
+    ggml_sycl_pool_alloc<sycl::half> scales(ctx.pool(), row_diff * groups);
+    q8_0_reorder_scales_to_kn(d, scales.get(), row_diff, groups, stream);
+
+    const char * impl = "";
+    bool         ok   = false;
+    try {
+        ok = DnnlGemmWrapper::woq_q8_0_gemm(ctx, (int) row_diff, (int) src1_ncols, (int) ne00, qs, scales.get(),
+                                            src1_ptr, dst_dd_i, ldc, stream, &impl);
+    } catch (const dnnl::error & e) {
+        GGML_LOG_WARN("%s: oneDNN failed (%s), back to dequantize + GEMM\n", __func__, e.what());
+    }
+    static std::atomic<bool> reported{ false };
+    if (!reported.exchange(true)) {
+        GGML_LOG_INFO("%s: oneDNN weight-only Q8_0 matmul %s (%s)\n", __func__, ok ? "used" : "declined",
+                      impl[0] ? impl : "no implementation");
+    }
+    if (!ok) {
+        g_ggml_sycl_woq_q8_0_declined.store(true, std::memory_order_relaxed);
+        return false;
+    }
+    GGML_SYCL_DEBUG("[SYCL] %s: m=%lld n=%lld k=%lld (%s)\n", __func__, (long long) row_diff,
+                    (long long) src1_ncols, (long long) ne00, impl);
+    return true;
+}
+#endif
