     use_fp16 = use_fp16 && ggml_sycl_src1_f16_ok(dst);
     // F8_E4M3 widens to f16 exactly
@@ -5276,6 +5366,30 @@ static void opt_for_reorder(ggml_backend_sycl_context * ctx, const ggml_tensor *
     }
 }
 
+// GGML_SYCL_WOQ_Q8_0 reads the reorder layout, which a weight otherwise gets on its first call of at most 8
+// tokens: install it on a prompt batch too, so a run that starts with (or only has) prompts reaches that path.
+// Every Q8_0 reader handles the layout (decode installs it anyway); this only changes when it happens.
+static void opt_for_reorder_woq_q8_0(ggml_backend_sycl_context * ctx, const ggml_tensor * src0,
+                                     const ggml_tensor * src1) {
+#if GGML_SYCL_DNNL && defined(GGML_SYCL_F16)
+    if (!ggml_sycl_woq_q8_0_possible(ctx->device) || src0->type != GGML_TYPE_Q8_0 || !g_ggml_sycl_enable_optimize ||
+        !ctx->opt_feature.reorder || src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return;
+    }
+    ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(src0->extra);
+    if (!extra || extra->optimized_feature.reorder) {
+        return;
+    }
+    if (reorder_qw(src0, ctx->stream())) {
+        extra->optimized_feature.reorder = true;
+    }
+#else
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(src0);
+    GGML_UNUSED(src1);
+#endif
+}
+
 // Lazily reorder supported MoE expert weights once their fused path is used.
 static void opt_for_reorder_id(ggml_backend_sycl_context * ctx, const ggml_tensor * src0) {
     if (!g_ggml_sycl_enable_optimize || !ctx->opt_feature.reorder) {
@@ -5462,6 +5576,9 @@ static void ggml_sycl_mul_mat(ggml_backend_sycl_context & ctx, const ggml_tensor
             ggml_sycl_op_mul_mat<quantize_q8_1>(ctx, src0, src1, dst, ggml_sycl_op_mul_mat_q);
         }
     } else {
+        if (!split) {
+            opt_for_reorder_woq_q8_0(&ctx, src0, src1);
+        }
         ggml_sycl_op_mul_mat<no_quantize_q8_1>(ctx, src0, src1, dst, ggml_sycl_op_mul_mat_sycl);
     }
 }
