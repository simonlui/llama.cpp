         GGML_LOG_INFO("  GGML_SYCL_FA_ONEDNN: %d\n", g_ggml_sycl_fa_onednn);
         GGML_LOG_INFO("  GGML_SYCL_FA_ONEDNN_DG2_HD64: %d\n", g_ggml_sycl_fa_onednn_dg2_hd64);
