+// ---------------------------------------------------------------------------------------------
+// XMX (dpas) variant of the q8_0 D=256 decode kernel. A work-group owns one (KV head, chunk) and
+// all the query rows of that KV head (gqa x n_tok), in groups of 8 rows. Its threads are
+// (row group, 64-dim slice). Per tile of 16 KV positions the K and V rows are dequantized once,
+// cooperatively, to f16 in SLM, laid out as dpas B operands:
+//   K: dword (k2, n) of block (g, c) = dims 16c + 2k2, +1 of position 8g + n
+//   V: dword (k2, n) of block j      = positions 2k2, 2k2 + 1 of dim 8j + n
+// Every thread computes the 8 x 16 scores of its row group with 32 dpas (the four dim slices
+// repeat it, it is cheap), runs the online softmax and accumulates P x V for its 64 dims with 8
+// dpas. Q comes pre-scaled in f16 dpas A layout (gqa_xmx_prep_q). Partials and meta use the
+// layout of the scalar kernels, so the same merge follows.
+// ---------------------------------------------------------------------------------------------
+static void gqa_xmx_prep_q(const char * Q, sycl::half * q16, float scale, int n_tok, int gqa, int n_kvh, int nrg,
+                           size_t nbq1, size_t nbq2, dpct::queue_ptr stream) {
+    constexpr int D = 256;
+    // q16[kvh][rg][c][r][16]
+    stream->parallel_for(sycl::range<1>((size_t) n_kvh * nrg * 8 * D), [=](sycl::item<1> it) {
+        const size_t id  = it.get_id(0);
+        const int    d   = id % D;
+        const int    r   = (id / D) % 8;
+        const int    rg  = (id / D / 8) % nrg;
+        const int    kvh = id / D / 8 / nrg;
+        const int    rr  = rg * 8 + r;
+        float        v   = 0.0f;
+        if (rr < gqa * n_tok) {
+            const int t = rr / gqa;
+            const int h = kvh * gqa + rr % gqa;
+            v           = ((const float *) (Q + (size_t) t * nbq1 + (size_t) h * nbq2))[d] * scale;
+        }
+        const int c = d / 16;
+        q16[((((size_t) kvh * nrg + rg) * 16 + c) * 8 + r) * 16 + d % 16] = (sycl::half) v;
+    });
+}
+
+static void gqa_dec_partial_xmx_q8_256(const sycl::half * q16, const char * K, const char * V, const char * mask,
+                                       float * part, float * meta, int n_tok, int n_head, int gqa, int n_kv,
+                                       int n_chunks, size_t nbk1, size_t nbk2, size_t nbv1, size_t nbv2, size_t nbm1,
+                                       int chunk_sz, dpct::queue_ptr stream) {
+    constexpr int D   = 256;
+    constexpr int TP  = 16;                 // positions per tile
+    constexpr int SLK = 0;                  // SLM byte offsets: K tile (16 x 256 f16), V tile
+    constexpr int SLV = TP * D * 2;
+    const int     R   = gqa * n_tok;
+    const int     nrg = (R + 7) / 8;
+    const int     nth = nrg * 4;            // threads per work-group: row groups x dim slices
+    const int     n_kvh = n_head / gqa;
+    static const int xpf_env = ggml_sycl_get_env("GGML_SYCL_FA_XMX_PF", 1);
+    const int        xpf     = xpf_env;
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>((size_t) n_kvh * n_chunks * nth), sycl::range<1>(nth)),
+            sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size<256> },
+            [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+                using namespace sycl::ext::intel::esimd;
+                namespace xmx = sycl::ext::intel::esimd::xmx;
+                slm_init<2 * TP * D * 2>();
+                const int tid   = it.get_local_id(0);
+                const int grp   = it.get_group(0);
+                const int chunk = grp % n_chunks;
+                const int kvh   = grp / n_chunks;
+                const int rg    = tid / 4;
+                const int sl    = tid % 4;  // 64-dim slice
+                const int p0    = chunk * chunk_sz;
+                const int p1    = p0 + chunk_sz < n_kv ? p0 + chunk_sz : n_kv;
+                const char * Kh = K + (size_t) kvh * nbk2;
+                const char * Vh = V + (size_t) kvh * nbv2;
+                const sycl::half * qa = q16 + ((size_t) kvh * nrg + rg) * 16 * 128;
+
+                // the token of each of the 8 rows (mask row), -1 for padding rows
+                int rt[8];
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    const int rr = rg * 8 + r;
+                    rt[r]        = rr < R ? rr / gqa : -1;
+                }
+                simd<float, 64> acc[8];
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    acc[j] = 0.0f;
+                }
+                simd<float, 8> m = -INFINITY, l = 0.0f;
+                simd<float, 64> pad64 = 0.0f;
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    if (rt[r] < 0) {
+                        pad64.template select<8, 1>(8 * r) = -INFINITY;
+                    }
+                }
+
+                for (int p = p0; p < p1; p += TP) {
+                    const int np = p1 - p < TP ? p1 - p : TP;
+                    barrier();
+                    // loaders: tasks 0..15 = K rows, 16..23 = V row pairs
+                    for (int task = tid; task < TP + TP / 2; task += nth) {
+                        if (task < TP) {
+                            const int          pi  = p + (task < np ? task : np - 1);
+                            simd<uint32_t, 68> raw = gqa_esimd_load_row_q8_256(Kh + (size_t) pi * nbk1);
+                            simd<float, D>     f;
+                            gqa_esimd_deq_raw_q8_256(raw, f);
+                            simd<sycl::half, D> h  = simd<sycl::half, D>(f);
+                            simd<uint32_t, 128> hd = h.template bit_cast_view<uint32_t>();
+                            // dword d2 of position n of group g -> g * 1024 + d2 * 8 + n
+                            const int g = task / 8, n = task % 8;
+                            simd<uint32_t, 16> off(0u, 8u * 4u);
+#pragma unroll
+                            for (int q = 0; q < 8; ++q) {
+                                slm_scatter<uint32_t, 16>(off + (uint32_t) (SLK + (g * 1024 + q * 16 * 8 + n) * 4),
+                                                          hd.template select<16, 1>(16 * q));
+                            }
+                        } else {
+                            const int          k2  = task - TP;
+                            const int          pa  = p + (2 * k2 < np ? 2 * k2 : np - 1);
+                            const int          pb  = p + (2 * k2 + 1 < np ? 2 * k2 + 1 : np - 1);
+                            simd<float, D>     fa, fb;
+                            gqa_esimd_deq_raw_q8_256(gqa_esimd_load_row_q8_256(Vh + (size_t) pa * nbv1), fa);
+                            gqa_esimd_deq_raw_q8_256(gqa_esimd_load_row_q8_256(Vh + (size_t) pb * nbv1), fb);
+                            if (2 * k2 >= np) {
+                                fa = 0.0f;
+                            }
+                            if (2 * k2 + 1 >= np) {
+                                fb = 0.0f;
+                            }
+                            simd<sycl::half, 2 * D> h;
+                            h.template select<D, 2>(0) = simd<sycl::half, D>(fa);
+                            h.template select<D, 2>(1) = simd<sycl::half, D>(fb);
+                            simd<uint32_t, D> hd = h.template bit_cast_view<uint32_t>();
+                            // dword of dim d -> (d / 8) * 64 + k2 * 8 + d % 8
+#pragma unroll
+                            for (int j = 0; j < D / 8; ++j) {
+                                slm_block_store<uint32_t, 8>((uint32_t) (SLV + (j * 64 + k2 * 8) * 4),
+                                                             hd.template select<8, 1>(8 * j));
+                            }
+                        }
+                    }
+                    barrier();
+                    // the rows this thread loads for the next tile: requested now, so the loads of
+                    // the next iteration hit the caches while this tile is computed
+                    if (xpf) {
+                        for (int task = tid; task < TP + TP / 2; task += nth) {
+                            if (task < TP) {
+                                const int pn = p + TP + task;
+                                if (pn < p1) {
+                                    gqa_esimd_prefetch_row_q8_256(Kh + (size_t) pn * nbk1);
+                                }
+                            } else {
+                                const int pn = p + TP + 2 * (task - TP);
+                                if (pn < p1) {
+                                    gqa_esimd_prefetch_row_q8_256(Vh + (size_t) pn * nbv1);
+                                }
+                                if (pn + 1 < p1) {
+                                    gqa_esimd_prefetch_row_q8_256(Vh + (size_t) (pn + 1) * nbv1);
+                                }
+                            }
+                        }
+                    }
+
+                    // scores: two 8 x 8 blocks (positions 0..7, 8..15)
+                    // 8 independent accumulation chains (2 position groups x 4), summed at the end:
+                    // a single chain of 16 dependent dpas exposes the XMX latency every step
+                    simd<float, 64> sc[2];
+                    simd<float, 64> sp[2][4];
+#pragma unroll
+                    for (int g = 0; g < 2; ++g) {
+#pragma unroll
+                        for (int k = 0; k < 4; ++k) {
+                            sp[g][k] = 0.0f;
+                        }
+                    }
+#pragma unroll
+                    for (int c = 0; c < 16; ++c) {
+                        simd<sycl::half, 128> A = block_load<sycl::half, 128>(qa + c * 128);
+#pragma unroll
+                        for (int g = 0; g < 2; ++g) {
+                            simd<uint32_t, 64>    Bd = slm_block_load<uint32_t, 64>((uint32_t) (SLK + (g * 1024 + c * 64) * 4));
+                            simd<sycl::half, 128> B  = Bd.template bit_cast_view<sycl::half>();
+                            sp[g][c % 4]             = xmx::dpas<8, 8, float>(sp[g][c % 4], B, A);
+                        }
+                    }
+#pragma unroll
+                    for (int g = 0; g < 2; ++g) {
+                        sc[g] = (sp[g][0] + sp[g][1]) + (sp[g][2] + sp[g][3]);
+                    }
+                    // mask: rows of one token share it (one 32-byte load per distinct token);
+                    // padding rows and tail positions get -inf
+                    sc[0] += pad64;
+                    sc[1] += pad64;
+                    if (mask) {
+                        int                  tprev = -2;
+                        simd<float, 16>      mv;
+#pragma unroll
+                        for (int r = 0; r < 8; ++r) {
+                            if (rt[r] < 0) {
+                                continue;
+                            }
+                            if (rt[r] != tprev) {
+                                tprev                  = rt[r];
+                                const sycl::half * mr  = (const sycl::half *) (mask + (size_t) rt[r] * nbm1) + p;
+                                if (np == TP) {
+                                    mv = convert<float>(block_load<sycl::half, 16>(mr));
+                                } else {
+#pragma unroll
+                                    for (int i2 = 0; i2 < TP; ++i2) {
+                                        mv[i2] = i2 < np ? (float) mr[i2] : -INFINITY;
+                                    }
+                                }
+                            }
+                            sc[0].template select<8, 1>(8 * r) += mv.template select<8, 1>(0);
+                            sc[1].template select<8, 1>(8 * r) += mv.template select<8, 1>(8);
+                        }
+                    } else if (np < TP) {
+                        simd<float, 16> tv;
+#pragma unroll
+                        for (int i2 = 0; i2 < TP; ++i2) {
+                            tv[i2] = i2 < np ? 0.0f : -INFINITY;
+                        }
+                        simd<float, 8> t0 = tv.template select<8, 1>(0), t1 = tv.template select<8, 1>(8);
+                        sc[0] += t0.template replicate<8>();
+                        sc[1] += t1.template replicate<8>();
+                    }
+                    // online softmax, all 8 rows at once ([row][8] layout: row values are 8 contiguous lanes)
+                    simd<float, 64> mx = max<float>(sc[0], sc[1]);
+                    simd<float, 32> ma = mx.template select<32, 2>(0), mb = mx.template select<32, 2>(1);
+                    simd<float, 32> m4 = max<float>(ma, mb);
+                    simd<float, 16> mc = m4.template select<16, 2>(0), md = m4.template select<16, 2>(1);
+                    simd<float, 16> m2 = max<float>(mc, md);
+                    simd<float, 8>  me = m2.template select<8, 2>(0), mf = m2.template select<8, 2>(1);
+                    simd<float, 8>  tm = max<float>(me, mf);
+                    simd<float, 8>  mn = max<float>(m, tm);
+                    // rows still without any position: keep a finite reference (their scores are -inf)
+                    simd<float, 8> mref = mn;
+                    mref.merge(0.0f, mn == -INFINITY);
+                    simd<float, 8> al8 = exp(m - mref);
+                    al8.merge(0.0f, m == -INFINITY);
+                    simd<float, 64> mref64 = mref.template replicate_vs_w_hs<8, 1, 8, 0>(0);
+                    simd<float, 64> e0     = exp(sc[0] - mref64);
+                    simd<float, 64> e1     = exp(sc[1] - mref64);
+                    simd<float, 64> es     = e0 + e1;
+                    simd<float, 32> s4     = es.template select<32, 2>(0) + es.template select<32, 2>(1);
+                    simd<float, 16> s2     = s4.template select<16, 2>(0) + s4.template select<16, 2>(1);
+                    simd<float, 8>  rs     = s2.template select<8, 2>(0) + s2.template select<8, 2>(1);
+                    l                      = l * al8 + rs;
+                    m                      = mn;
+                    simd<float, 64> al     = al8.template replicate_vs_w_hs<8, 1, 8, 0>(0);
+                    simd<sycl::half, 128> P;
+                    auto                  P2 = P.template bit_cast_view<sycl::half, 8, 16>();
+                    P2.template select<8, 1, 8, 1>(0, 0) = simd<sycl::half, 64>(e0);
+                    P2.template select<8, 1, 8, 1>(0, 8) = simd<sycl::half, 64>(e1);
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        simd<uint32_t, 64>    Bd = slm_block_load<uint32_t, 64>((uint32_t) (SLV + ((sl * 8 + j) * 64) * 4));
+                        simd<sycl::half, 128> B  = Bd.template bit_cast_view<sycl::half>();
+                        acc[j]                   = xmx::dpas<8, 8, float>(acc[j] * al, B, P);
+                    }
+                }
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    if (rt[r] < 0) {
+                        continue;
+                    }
+                    const int    rr     = rg * 8 + r;
+                    const int    h      = kvh * gqa + rr % gqa;
+                    const size_t row_id = ((size_t) chunk * n_tok + rt[r]) * n_head + h;
+                    simd<float, 64> o;
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        o.template select<8, 1>(8 * j) = acc[j].template select<8, 1>(8 * r);
+                    }
+                    block_store<float, 64>(part + row_id * D + sl * 64, o);
+                    if (sl == 0) {
+                        simd<float, 2> mm;
+                        mm[0] = m[r];
+                        mm[1] = l[r];
+                        block_store<float, 2>(meta + row_id * 2, mm);
+                    }
+                }
+            });
+    });
+}
+
+// merge of the chunk partials: one work-group per (token, head) row; the chunk weights are
+// computed once per row in local memory, then every work-item sums its D column over chunks
+template <int D>
+static void gqa_dec_merge2(const float * part, const float * meta, float * dst, int n_tok, int n_head, int n_chunks,
+                           dpct::queue_ptr stream) {
+    const size_t n_rows = (size_t) n_tok * n_head;
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> w(sycl::range<1>(n_chunks + 1), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(n_rows * D, D), [=](sycl::nd_item<1> it) {
+            const size_t row = it.get_group(0);
+            const int    d   = it.get_local_id(0);
+            // global max
+            float M = -INFINITY;
+            for (int c = d; c < n_chunks; c += D) {
+                M = sycl::fmax(M, meta[(c * n_rows + row) * 2]);
+            }
+            M = sycl::reduce_over_group(it.get_group(), M, sycl::maximum<float>());
+            float S = 0.0f;
+            for (int c = d; c < n_chunks; c += D) {
+                const float mc = meta[(c * n_rows + row) * 2];
+                const float wc = (M == -INFINITY || mc == -INFINITY) ? 0.0f : sycl::native::exp(mc - M);
+                w[c]           = wc;
+                S += meta[(c * n_rows + row) * 2 + 1] * wc;
+            }
+            S = sycl::reduce_over_group(it.get_group(), S, sycl::plus<float>());
+            sycl::group_barrier(it.get_group());
+            float out = 0.0f;
+            for (int c = 0; c < n_chunks; ++c) {
+                const float wc = w[c];
+                if (wc != 0.0f) {
+                    out += part[(c * n_rows + row) * D + d] * wc;
+                }
+            }
+            dst[row * D + d] = S > 0.0f ? out / S : 0.0f;
+        });
+    });
+}
+
+// merge with more parallelism: one work-group per (row, 64-dim slice), its 256 work-items are
+// 64 dims x 4 chunk lanes (each lane sums every 4th chunk, the lanes are added through SLM). The
+// per-row variant above runs n_tok * n_head work-groups that each walk all chunks serially.
+template <int D>
+static void gqa_dec_merge3(const float * part, const float * meta, float * dst, int n_tok, int n_head, int n_chunks,
+                           dpct::queue_ptr stream) {
+    constexpr int SL = 64, CL = 4;
+    const size_t  n_rows = (size_t) n_tok * n_head;
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> w(sycl::range<1>(n_chunks + 1), cgh);
+        sycl::local_accessor<float, 1> red(sycl::range<1>(SL * CL), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(n_rows * (D / SL) * SL * CL, SL * CL), [=](sycl::nd_item<1> it) {
+            const size_t g   = it.get_group(0);
+            const size_t row = g / (D / SL);
+            const int    d0  = (g % (D / SL)) * SL;
+            const int    lid = it.get_local_id(0);
+            const int    dl  = lid % SL;
+            const int    cl  = lid / SL;
+            float        M   = -INFINITY;
+            for (int c = lid; c < n_chunks; c += SL * CL) {
+                M = sycl::fmax(M, meta[(c * n_rows + row) * 2]);
+            }
+            M       = sycl::reduce_over_group(it.get_group(), M, sycl::maximum<float>());
+            float S = 0.0f;
+            for (int c = lid; c < n_chunks; c += SL * CL) {
+                const float mc = meta[(c * n_rows + row) * 2];
+                const float wc = (M == -INFINITY || mc == -INFINITY) ? 0.0f : sycl::native::exp(mc - M);
+                w[c]           = wc;
+                S += meta[(c * n_rows + row) * 2 + 1] * wc;
+            }
+            S = sycl::reduce_over_group(it.get_group(), S, sycl::plus<float>());
+            sycl::group_barrier(it.get_group());
+            float out = 0.0f;
+            for (int c = cl; c < n_chunks; c += CL) {
+                out += part[(c * n_rows + row) * D + d0 + dl] * w[c];
+            }
+            red[lid] = out;
+            sycl::group_barrier(it.get_group());
+            if (cl == 0) {
+                float o = red[dl] + red[SL + dl] + red[2 * SL + dl] + red[3 * SL + dl];
+                dst[row * D + d0 + dl] = S > 0.0f ? o / S : 0.0f;
+            }
+        });
+    });
+}
+
+bool ggml_sycl_fattn_gqa_decode_supported(const ggml_tensor * dst) {
+    static const int on = ggml_sycl_get_env("GGML_SYCL_FA_GQA_DEC", 1);
+    if (!on) {
+        return false;
+    }
+    const ggml_tensor * Q     = dst->src[0];
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    if (sinks || Q->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || K->type != V->type) {
+        return false;
+    }
+    if (K->type != GGML_TYPE_Q8_0 && K->type != GGML_TYPE_F16) {
+        return false;
+    }
+    const int D = Q->ne[0];
+    if ((D != 64 && D != 128 && D != 256) || K->ne[0] != D || V->ne[0] != D) {
+        return false;
+    }
+    if (Q->ne[1] < 1 || Q->ne[1] > 8 || Q->ne[3] != 1 || K->ne[3] != 1) {
+        return false;
+    }
+    if (Q->ne[2] % K->ne[2] != 0 || K->ne[2] != V->ne[2]) {
+        return false;
+    }
+    const int gqa = Q->ne[2] / K->ne[2];
+    if (gqa < 2 || gqa * Q->ne[1] > 64) {  // work-group = query rows * 16 lanes <= 1024
+        return false;
+    }
+    if (mask && (mask->type != GGML_TYPE_F16 || mask->ne[2] != 1 || mask->ne[3] != 1)) {
+        return false;
+    }
+    float max_bias = 0.0f, softcap = 0.0f;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || softcap != 0.0f) {
+        return false;
+    }
+    // dst rows are [t][h][D] contiguous
+    return ggml_is_contiguous(dst) && dst->ne[0] == D && dst->ne[1] == Q->ne[2] && dst->ne[2] == Q->ne[1];
+}
+
+#ifndef GQA_DEC_STANDALONE
+void ggml_sycl_fattn_gqa_decode(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    float scale = 1.0f;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+
+    const int D        = Q->ne[0];
+    const int n_tok    = Q->ne[1];
+    const int n_head   = Q->ne[2];
+    const int gqa      = n_head / K->ne[2];
+    const int n_kv     = K->ne[1];
+    const int chunk_sz = gqa_dec_chunk();
+    const int n_chunks = (n_kv + chunk_sz - 1) / chunk_sz;
+
+    dpct::queue_ptr stream = ctx.stream();
+    const size_t    n_rows = (size_t) n_tok * n_head;
+    const char * mp_e   = mask ? (const char *) mask->data : nullptr;
+    const size_t nbm1_e = mask ? mask->nb[1] : 0;
+    static const int use_esimd    = ggml_sycl_get_env("GGML_SYCL_FA_GQA_ESIMD", 1);
+    // GGML_SYCL_FA_ESIMD_CHUNK: KV positions per chunk with 2+ query tokens; GGML_SYCL_FA_CHUNK1: with one
+    // (one token has 3 threads per chunk: smaller chunks give the GPU enough threads)
+    static const int esimd_chunk_n = ggml_sycl_get_env("GGML_SYCL_FA_ESIMD_CHUNK", 128);
+    static const int esimd_chunk_1 = ggml_sycl_get_env("GGML_SYCL_FA_CHUNK1", 80);
+    const int        esimd_chunk   = n_tok == 1 ? esimd_chunk_1 : esimd_chunk_n;
+    if (use_esimd && K->type == GGML_TYPE_Q8_0 && D == 256 && (gqa * n_tok) % GQA_ESIMD_RT == 0) {
+        const int n_chunks_e = (n_kv + esimd_chunk - 1) / esimd_chunk;
+        size_t    alloc_c    = 1;
+        while (alloc_c < (size_t) n_chunks_e) {
+            alloc_c <<= 1;
+        }
+        ggml_sycl_pool_alloc<float> part_e(ctx.pool(), alloc_c * 8 * n_head * D);
+        ggml_sycl_pool_alloc<float> meta_e(ctx.pool(), alloc_c * 8 * n_head * 2);
+        // GGML_SYCL_FA_ESIMD_SLM=1: work-group variant with the K/V tiles dequantized once into SLM
+        static const int esimd_slm = ggml_sycl_get_env("GGML_SYCL_FA_ESIMD_SLM", 1);
+        // GGML_SYCL_FA_SLM_MIN: fewest query tokens that use the work-group (SLM) variant
+        static const int slm_min   = ggml_sycl_get_env("GGML_SYCL_FA_SLM_MIN", 2);
+        // GGML_SYCL_FA_XMX=N: dpas kernel from N query tokens on (0 = off)
+        static const int fa_xmx       = ggml_sycl_get_env("GGML_SYCL_FA_XMX", 0);
+        static const int fa_xmx_chunk = ggml_sycl_get_env("GGML_SYCL_FA_XMX_CHUNK", 256);
+        if (fa_xmx > 0 && n_tok >= fa_xmx) {
+            const int nrg      = (gqa * n_tok + 7) / 8;
+            const int n_kvh    = n_head / gqa;
+            const int n_chunks = (n_kv + fa_xmx_chunk - 1) / fa_xmx_chunk;
+            size_t    ac       = 1;
+            while (ac < (size_t) n_chunks) {
+                ac <<= 1;
+            }
+            ggml_sycl_pool_alloc<float>      part_x(ctx.pool(), ac * 8 * n_head * D);
+            ggml_sycl_pool_alloc<float>      meta_x(ctx.pool(), ac * 8 * n_head * 2);
+            ggml_sycl_pool_alloc<sycl::half> q16(ctx.pool(), (size_t) n_kvh * nrg * 8 * D);
+            gqa_xmx_prep_q((const char *) Q->data, q16.get(), scale, n_tok, gqa, n_kvh, nrg, Q->nb[1], Q->nb[2], stream);
+            gqa_dec_partial_xmx_q8_256(q16.get(), (const char *) K->data, (const char *) V->data, mp_e, part_x.get(),
+                                       meta_x.get(), n_tok, n_head, gqa, n_kv, n_chunks, K->nb[1], K->nb[2], V->nb[1],
+                                       V->nb[2], nbm1_e, fa_xmx_chunk, stream);
+            gqa_dec_merge3<256>(part_x.get(), meta_x.get(), (float *) dst->data, n_tok, n_head, n_chunks, stream);
+            return;
+        }
+        // GGML_SYCL_FA_SLM_RT: query rows per thread of the work-group variant (2 or 3): every row a thread
+        // owns reuses the K/V values it reads from SLM
+        static const int slm_rt = ggml_sycl_get_env("GGML_SYCL_FA_SLM_RT", 2);
+        // GGML_SYCL_FA_SLM_F16: K/V tiles kept in SLM as f16 (half the SLM traffic)
+        static const int slm_f16 = ggml_sycl_get_env("GGML_SYCL_FA_SLM_F16", 0);
+        if (esimd_slm && n_tok >= slm_min && slm_rt == 3 && (gqa * n_tok) % 3 == 0) {
+            gqa_dec_partial_esimd_slm_q8_256<3>((const char *) Q->data, (const char *) K->data, (const char *) V->data, mp_e,
+                                             part_e.get(), meta_e.get(), scale, n_tok, n_head, gqa, n_kv, n_chunks_e,
+                                             Q->nb[1], Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2], nbm1_e,
+                                             esimd_chunk, stream);
+        } else if (esimd_slm && n_tok >= slm_min && slm_f16) {
+            gqa_dec_partial_esimd_slm_q8_256<GQA_ESIMD_RT, 2>((const char *) Q->data, (const char *) K->data, (const char *) V->data, mp_e,
+                                             part_e.get(), meta_e.get(), scale, n_tok, n_head, gqa, n_kv, n_chunks_e,
+                                             Q->nb[1], Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2], nbm1_e,
+                                             esimd_chunk, stream);
+        } else if (esimd_slm && n_tok >= slm_min) {
+            gqa_dec_partial_esimd_slm_q8_256<GQA_ESIMD_RT>((const char *) Q->data, (const char *) K->data, (const char *) V->data, mp_e,
+                                             part_e.get(), meta_e.get(), scale, n_tok, n_head, gqa, n_kv, n_chunks_e,
+                                             Q->nb[1], Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2], nbm1_e,
+                                             esimd_chunk, stream);
+        } else {
+            gqa_dec_partial_esimd_q8_256((const char *) Q->data, (const char *) K->data, (const char *) V->data, mp_e,
+                                         part_e.get(), meta_e.get(), scale, n_tok, n_head, gqa, n_kv, n_chunks_e,
+                                         Q->nb[1], Q->nb[2], K->nb[1], K->nb[2], V->nb[1], V->nb[2], nbm1_e,
+                                         esimd_chunk, stream);
+        }
+        // GGML_SYCL_FA_MERGE3=1 (default): sliced merge, 0: one work-group per row
+        static const int merge3 = ggml_sycl_get_env("GGML_SYCL_FA_MERGE3", 1);
+        if (merge3) {
+            gqa_dec_merge3<256>(part_e.get(), meta_e.get(), (float *) dst->data, n_tok, n_head, n_chunks_e, stream);
+        } else {
+            gqa_dec_merge2<256>(part_e.get(), meta_e.get(), (float *) dst->data, n_tok, n_head, n_chunks_e, stream);
+        }
+        return;
+    }
+
+    // round the chunk count up to a power of two: the KV length grows every call and the
+    // legacy pool would otherwise cache a new, slightly larger buffer each time
+    size_t n_chunks_alloc = 1;
+    while (n_chunks_alloc < (size_t) n_chunks) {
+        n_chunks_alloc <<= 1;
+    }
+    ggml_sycl_pool_alloc<float> part(ctx.pool(), n_chunks_alloc * 8 * n_head * D);
+    ggml_sycl_pool_alloc<float> meta(ctx.pool(), n_chunks_alloc * 8 * n_head * 2);
+
+    const char * mp   = mask ? (const char *) mask->data : nullptr;
+    const size_t nbm1 = mask ? mask->nb[1] : 0;
+
+#define GQA_DEC_RUN(DD, TT)                                                                                           \
+    gqa_dec_partial<DD, TT>((const char *) Q->data, (const char *) K->data, (const char *) V->data, mp, part.get(),  \
+                            meta.get(), scale, n_tok, n_head, gqa, n_kv, n_chunks, Q->nb[1], Q->nb[2], K->nb[1],     \
+                            K->nb[2], V->nb[1], V->nb[2], nbm1, chunk_sz, stream);                                             \
+    gqa_dec_merge<DD>(part.get(), meta.get(), (float *) dst->data, n_tok, n_head, n_chunks, stream)
+
+    const bool q8 = K->type == GGML_TYPE_Q8_0;
+    switch (D) {
+        case 64:  if (q8) { GQA_DEC_RUN(64, GGML_TYPE_Q8_0); } else { GQA_DEC_RUN(64, GGML_TYPE_F16); } break;
+        case 128: if (q8) { GQA_DEC_RUN(128, GGML_TYPE_Q8_0); } else { GQA_DEC_RUN(128, GGML_TYPE_F16); } break;
+        case 256: if (q8) { GQA_DEC_RUN(256, GGML_TYPE_Q8_0); } else { GQA_DEC_RUN(256, GGML_TYPE_F16); } break;
+        default: GGML_ABORT("gqa decode: unsupported D=%d", D);
+    }
+#undef GQA_DEC_RUN
+}
+#endif // GQA_DEC_STANDALONE
