index 823b713c..31dd708e 100644
--- a/ggml/src/ggml-sycl/lightning-indexer.cpp
+++ b/ggml/src/ggml-sycl/lightning-indexer.cpp
@@ -1,5 +1,6 @@
 #include "lightning-indexer.hpp"
 #include "dequantize.hpp"
+#include "xmx.hpp"
 
 static void lightning_indexer_f32_sycl(
         const char * q, const char * k, const char * w, const char * m, float * dst,
@@ -144,6 +145,359 @@ static void lightning_indexer_f32_sycl(
         });
