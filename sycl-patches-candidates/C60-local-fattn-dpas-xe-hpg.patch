+#if defined(GGML_SYCL_SUPPORT_XMX) && (!defined(GGML_SYCL_XMX_AOT_SG) || GGML_SYCL_XMX_AOT_SG == 16)
+#define GGML_SYCL_FA_DPAS_SG16 1
 #else
-#define GGML_SYCL_FA_DPAS_BUILD 1
