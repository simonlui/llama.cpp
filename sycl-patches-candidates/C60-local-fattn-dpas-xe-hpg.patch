+#if defined(GGML_SYCL_SUPPORT_XMX) && (!defined(GGML_SYCL_XMX_AOT_SG) || GGML_SYCL_XMX_AOT_SG == 8)
+#define GGML_SYCL_FA_DPAS_SG8 1
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+#else
+#define GGML_SYCL_FA_DPAS_SG8 0
+#endif
+#define GGML_SYCL_FA_DPAS_BUILD (GGML_SYCL_FA_DPAS_SG16 || GGML_SYCL_FA_DPAS_SG8)
+// 1 keeps the per-DPAS row-tile guard in every Q.K loop (the A/B baseline for the sub-group-8 Q.K fix below)
+#ifndef GGML_SYCL_FA_DPAS_QK_GUARD
+#define GGML_SYCL_FA_DPAS_QK_GUARD 0
 #endif
 
 #if GGML_SYCL_FA_DPAS_BUILD
 static constexpr int   FA_DPAS_WG    = 256;      // work-group size
-static constexpr int   FA_DPAS_NSG   = 16;       // sub-groups of 16 lanes
 static constexpr int   FA_DPAS_MAX_Q = 31;       // larger batches go to the prefill kernels
 static constexpr int   FA_DPAS_MAX_G = 32;       // query heads per KV head
 static constexpr float FA_DPAS_MINF  = -1.0e30f; // finite start value of the running max
 
+#if GGML_SYCL_FA_DPAS_SG16
 static bool fattn_dpas_support_arch(gpu_arch arch) {
     return arch == gpu_arch::intel_gpu_bmg_g21 || arch == gpu_arch::intel_gpu_bmg_g31 ||
            arch == gpu_arch::intel_gpu_lnl_m   || arch == gpu_arch::intel_gpu_ptl_h   ||
            arch == gpu_arch::intel_gpu_ptl_u   || arch == gpu_arch::intel_gpu_wcl;
 }
+#endif
+
+#if GGML_SYCL_FA_DPAS_SG8
+// Xe-HPG DPAS: the device lists the 8 x 8 x 32 int8 and 8 x 8 x 16 f16 tiles at sub-group 8. The s4 x s8 form of
+// the q4_0 kernel is no joint_matrix type, but every DPAS of this width has it.
+static bool fattn_dpas_device_has_sg8(const sycl::device & dev) {
+    namespace mx        = sycl::ext::oneapi::experimental::matrix;
+    const auto sg_sizes = dev.get_info<sycl::info::device::sub_group_sizes>();
+    if (!dev.is_gpu() || std::find(sg_sizes.begin(), sg_sizes.end(), (size_t) 8) == sg_sizes.end()) {
+        return false;
+    }
+    bool s8  = false;
+    bool f16 = false;
+    for (const auto & c : dev.get_info<sycl::ext::oneapi::experimental::info::device::matrix_combinations>()) {
+        if (!(c.max_msize >= 8 || c.msize == 8) || !(c.max_nsize >= 8 || c.nsize == 8)) {
+            continue;
+        }
+        s8  = s8 || (c.atype == mx::matrix_type::sint8 && c.btype == mx::matrix_type::sint8 &&
+                     c.ctype == mx::matrix_type::sint32 && c.dtype == mx::matrix_type::sint32 &&
+                     (c.max_ksize >= 32 || c.ksize == 32));
+        f16 = f16 || (c.atype == mx::matrix_type::fp16 && c.btype == mx::matrix_type::fp16 &&
+                      c.ctype == mx::matrix_type::fp32 && c.dtype == mx::matrix_type::fp32 &&
+                      (c.max_ksize >= 16 || c.ksize == 16));
+    }
+    return s8 && f16;
+}
+#endif
+
+// DPAS width of the kernel for this device: 16 on the Xe2 parts it was tuned on, 8 where the device lists the
+// Xe-HPG tiles, 0 for none. Cached per device.
+static int fattn_dpas_device_sg(int device) {
+    static std::mutex                   mtx;
+    static std::unordered_map<int, int> known;
+    std::lock_guard<std::mutex>         lock(mtx);
+    const auto                          it = known.find(device);
+    if (it != known.end()) {
+        return it->second;
+    }
+    int sg = 0;
+#if GGML_SYCL_FA_DPAS_SG16
+    if (fattn_dpas_support_arch(ggml_sycl_info().devices[device].hw_info.arch)) {
+        sg = 16;
+    }
+#endif
+#if GGML_SYCL_FA_DPAS_SG8
+    if (sg == 0) {
+        try {
+            if (fattn_dpas_device_has_sg8(dpct::dev_mgr::instance().get_device(device))) {
+                sg = 8;
+                GGML_LOG_INFO("%s: device %d: DPAS flash attention at sub-group 8 (Xe-HPG)\n", __func__, device);
+            }
+        } catch (const sycl::exception &) {
+            sg = 0;
+        }
+    }
+#endif
+    known.emplace(device, sg);
+    return sg;
+}
 
