 // One thread owns MR rows of one expert's weight and one BN-wide tile of the schedule, over the
 // whole K. Per k step (32 values) it loads the rows' stored bits, dequantizes them in registers to
 // the f16 A operand of dpas (RC = 8 rows x 16 k, row major) and multiplies it with the packed B,
-// which is already the dpas VNNI operand: [K/2][Npad][2] halves, 16 columns a row.
+// which is already the dpas VNNI operand: [K/2][Npad][2] halves, NW columns a dpas.
 //
 // The joint_matrix kernel dequantizes into SLM and reads it back in the same sub-group, which is
 // staging, not sharing; dpas takes registers, so that round trip and its barriers are gone here.
@@ -15,16 +15,48 @@
 // the same ascending order as its tile_c reduction, and every format below rounds A exactly as its
 // joint_matrix A stage does, so the output is the same bits.
 //
-// A weight format is a gg_esimd_a<block> with: raw, the stored bits of the MR rows for one k step;
-// load(), which fetches them from the expert's slice in either layout (gg_esimd::slice); and
+// A weight format is a gg_esimd_a<block, MR> with: raw, the stored bits of the MR rows for one k
+// step; load(), which fetches them from the expert's slice in either layout (gg_esimd::slice); and
 // decode(), the f16 A of one row group.
 // It reads the same fields as the joint_matrix A stage of its format.
+//
+// The kernel is built for one gg_arch: the dpas width NW (the columns of B one dpas takes, the
+// sub-group size of the joint_matrix combination it stands in for), the rows of one thread, and
+// whether 2D block loads exist. Xe2 and Xe-HPC: 16 wide, 32 rows, 2D loads. Xe-HPG (Arc A, ARL-H):
+// 8 wide, no 2D block messages, and 256 registers of 32 bytes, half of Xe2's file, so 16 rows: its
+// 32-row accumulators alone would take half the registers.
 static constexpr int GGML_SYCL_GG_KSPLIT = 4; // FG_KSPLIT of the joint_matrix kernel
 static constexpr int GGML_SYCL_GG_BN     = GGML_SYCL_FG_BN;
-static constexpr int GG_MR               = 32; // rows of one thread: one 2D load covers them
+static constexpr int GG_MR               = 32; // rows of one thread on Xe2: one 2D load covers them
 static constexpr int GG_RC               = 8;  // rows of one dpas
 static constexpr int GG_QK               = 32; // values of one k step
 
+template <int NW_, int MR_, bool L2D_> struct gg_arch {
+    static constexpr int  NW  = NW_;
+    static constexpr int  MR  = MR_;
+    static constexpr bool L2D = L2D_;
+};
+using gg_xe2   = gg_arch<16, GG_MR, true>;
+using gg_xehpg = gg_arch<8, 16, false>;
+
+// GGML_SYCL_GG_ESIMD_EMULATE_DPAS8 (a test build): the 8-wide dpas is computed in software, so the
+// Xe-HPG kernel runs, and can be checked, on an Xe2 device; GGML_SYCL_MMID_ESIMD_XEHPG=1 then routes
+// the 16-wide calls to it
+#if defined(GGML_SYCL_GG_ESIMD_EMULATE_DPAS8)
+static constexpr bool gg_emulate_dpas8 = true;
+#else
+static constexpr bool gg_emulate_dpas8 = false;
+#endif
+
+// An AOT build compiles each kernel only for the targets of its dpas width (FG_AOT_SG, fused-gemm.hpp)
+template <typename A> static constexpr bool gg_built() {
+#if defined(FG_AOT_SG)
+    return A::NW == FG_AOT_SG || (A::NW == 8 && gg_emulate_dpas8);
+#else
+    return true;
+#endif
+}
