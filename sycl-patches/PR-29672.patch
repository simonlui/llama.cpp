+static int test_ptq1_0_roundtrip(bool verbose) {
+    const auto * qfns     = ggml_get_type_traits(GGML_TYPE_PTQ1_0);
+    const auto * qfns_cpu = ggml_get_type_traits_cpu(GGML_TYPE_PTQ1_0);
