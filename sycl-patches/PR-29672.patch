+    std::vector<uint8_t> q(ggml_row_size(GGML_TYPE_PTQ1_0, n));
+
+    uint32_t seed = 1;
+    for (int b = 0; b < n_blocks; b++) {
+        const float scale = 0.25f * (1 + b % 8);
+        for (int i = 0; i < 128; i++) {
+            seed = seed * 1103515245u + 12345u;
+            x[b*128 + i] = scale * (float) ((int) ((seed >> 16) % 3) - 1);
+        }
