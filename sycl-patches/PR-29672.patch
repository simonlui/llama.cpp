+    qfns->to_float(q.data(), y.data(), n);
+
+    int n_diff = 0;
+    for (int i = 0; i < n; i++) {
+        n_diff += x[i] != y[i];
+    }
+
+    const bool failed = n_diff != 0;
+    if (failed || verbose) {
+        printf("%5s ternary round trip:            %s (%d of %d values differ)\n", ggml_type_name(GGML_TYPE_PTQ1_0), RESULT_STR[failed], n_diff, n);
+    }
+    return failed;
