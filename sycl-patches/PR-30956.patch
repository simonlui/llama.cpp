             h.parallel_for(sycl::range<1>(nelem), [=](sycl::id<1> i) {
@@ -7711,7 +7748,7 @@ bool ggml_backend_sycl_comm_allreduce_tensor(void * comm_ctx_v, struct ggml_tens
 
