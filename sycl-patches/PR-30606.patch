 ggml/src/ggml-sycl/base.hpp       |  7 +++++++
 ggml/src/ggml-sycl/fattn-tile.hpp | 10 ++--------
 ggml/src/ggml-sycl/ggml-sycl.cpp  |  3 +++
 4 files changed, 13 insertions(+), 8 deletions(-)

