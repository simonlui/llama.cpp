From dc0621d7a753d68a8b7e5e777d0f764133b9bdcb Mon Sep 17 00:00:00 2001
From: Todd Malsbary <todd.malsbary@intel.com>
Date: Mon, 26 Oct 2026 10:40:27 -0700
Subject: [PATCH] Remove check for host waits in fattn-mkl from graph checks

Commit 0a9ef00678 removed the host waits that prevented graphs from
being enabled on the fattn-mkl path.

Signed-off-by: Todd Malsbary <todd.malsbary@intel.com>
---
 ggml/src/ggml-sycl/fattn.cpp     | 4 ----
 ggml/src/ggml-sycl/fattn.hpp     | 3 ---
 ggml/src/ggml-sycl/ggml-sycl.cpp | 5 -----
 3 files changed, 12 deletions(-)

diff --git a/ggml/src/ggml-sycl/fattn.cpp b/ggml/src/ggml-sycl/fattn.cpp
index fef6e8d6..7afc5419 100644
--- a/ggml/src/ggml-sycl/fattn.cpp
+++ b/ggml/src/ggml-sycl/fattn.cpp
@@ -404,10 +404,6 @@ bool ggml_sycl_flash_attn_ext_supported(int device, const ggml_tensor * dst) {
     return ggml_sycl_get_best_fattn_kernel(device, dst) != BEST_FATTN_KERNEL_NONE;
 }
 
-bool ggml_sycl_flash_attn_ext_needs_sync(int device, const ggml_tensor * dst) {
-    return ggml_sycl_get_best_fattn_kernel(device, dst) == BEST_FATTN_KERNEL_MKL;
-}
-
 bool ggml_sycl_flash_attn_ext_uses_onednn(int device, const ggml_tensor * dst) {
     return ggml_sycl_get_best_fattn_kernel(device, dst) == BEST_FATTN_KERNEL_ONEDNN;
 }
diff --git a/ggml/src/ggml-sycl/fattn.hpp b/ggml/src/ggml-sycl/fattn.hpp
index 8ba63422..cfecf807 100644
--- a/ggml/src/ggml-sycl/fattn.hpp
+++ b/ggml/src/ggml-sycl/fattn.hpp
@@ -19,9 +19,6 @@ void ggml_sycl_flash_attn_ext(ggml_backend_sycl_context & ctx, ggml_tensor * dst
 
 bool ggml_sycl_flash_attn_ext_supported(int device, const ggml_tensor * dst);
 
-// Reports if flash attention runs this node with the oneMKL kernel, which waits on the host
-bool ggml_sycl_flash_attn_ext_needs_sync(int device, const ggml_tensor * dst);
-
 // Reports if flash attention runs this node with the oneDNN kernel
 bool ggml_sycl_flash_attn_ext_uses_onednn(int device, const ggml_tensor * dst);
 
diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index ae0f291c..4e715513 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -6888,11 +6888,6 @@ static bool check_graph_compatibility(ggml_backend_sycl_context * ctx, ggml_cgra
                 }
                 break;
             case GGML_OP_FLASH_ATTN_EXT:
-                if (ggml_sycl_flash_attn_ext_needs_sync(ctx->device, node)) {
-                    GGML_LOG_DEBUG("%s: disabling SYCL graphs due to host wait in %s\n", __func__,
-                                   ggml_op_name(node_op));
-                    return false;
-                }
 #ifndef GGML_SYCL_GRAPH_DNNL_SUPPORTED
                 if (ggml_sycl_flash_attn_ext_uses_onednn(ctx->device, node)) {
                     GGML_LOG_DEBUG("%s: disabling SYCL graphs due to %s using oneDNN\n", __func__,
-- 
2.43.0

