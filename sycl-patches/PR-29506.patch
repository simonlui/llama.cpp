From 129aae306605690a05c0e1680a8be089beff64d3 Mon Sep 17 00:00:00 2001
From: Alibek Omarov <a1ba.omarov@gmail.com>
Date: Sun, 27 Sep 2026 04:30:16 +0500
Subject: [PATCH 1/3] sycl: use ExternalProject to let this backend be built
 with SYCL compiler while everything else could use another

In my experiments, I wanted to test the GPU offloading with both ROCm and SYCL, however this configuration wasn't allowed
because ggml-sycl wants -fsycl capable compiler and ggml-hip wants hipcc. So this makes ggml-sycl to be built separately.

Tested: Ninja, icpx 2026.1, ROCm 7.1 + Vulkan + SYCL in one tree. llama.cpp listed
four devices (ROCm0, SYCL0, Vulkan0, Vulkan1 on an RX 9070 XT + Arc A770) and no-change incremental build finished immediately.

Not tested, possibly broken: Windows build, only selected flags reach nested builds.

Signed-off-by: Alibek Omarov <a1ba.omarov@gmail.com>
---
 ggml/CMakeLists.txt               |  3 ++
 ggml/src/ggml-sycl/CMakeLists.txt | 72 +++++++++++++++++++++++++++++++
 2 files changed, 75 insertions(+)

diff --git a/ggml/CMakeLists.txt b/ggml/CMakeLists.txt
index 752dabbb63ca..2a45788162ca 100644
--- a/ggml/CMakeLists.txt
+++ b/ggml/CMakeLists.txt
@@ -257,6 +257,9 @@ set   (GGML_SYCL_TARGET "INTEL" CACHE STRING
                                             "ggml: sycl target device")
 set   (GGML_SYCL_DEVICE_ARCH "" CACHE STRING
                                             "ggml: sycl device architecture")
+option(GGML_SYCL_SEPARATE_BUILD             "ggml: build in a nested project with its own C++ compiler, so the rest can use another compiler such as GCC or hipcc" OFF)
+set   (GGML_SYCL_SEPARATE_BUILD_CXX "icpx" CACHE STRING
+                                            "ggml: C++ compiler for GGML_SYCL_SEPARATE_BUILD")
 
 option(GGML_OPENVINO                        "ggml: use OPENVINO"                              OFF)
 option(GGML_ET                              "ggml: use ET backend"                            OFF)
diff --git a/ggml/src/ggml-sycl/CMakeLists.txt b/ggml/src/ggml-sycl/CMakeLists.txt
index d2196f74d565..5fe6ae6b20f4 100644
--- a/ggml/src/ggml-sycl/CMakeLists.txt
+++ b/ggml/src/ggml-sycl/CMakeLists.txt
@@ -4,6 +4,78 @@ if (NOT GGML_SYCL_TARGET MATCHES "^(INTEL)$")
     message(FATAL_ERROR "GGML_SYCL_TARGET: Invalid target, the supported options are [INTEL]")
 endif()
 
+# CMake build tree wants and can work with only one C++ compiler, but
+# - ggml-sycl wants -fsycl capable compiler
+# - ggml-hip wants hipcc
+# thanks ggml backends talking only through C API, we can freely build one backend with it's own compiler
+# so this branch does exactly that: we build this backend as externalproject, an existing pattern from hexagon backend
+if (GGML_SYCL_SEPARATE_BUILD)
+    if (NOT GGML_BACKEND_DL)
+        # only tested with shared libraries
+        message(FATAL_ERROR "GGML_SYCL_SEPARATE_BUILD requires GGML_BACKEND_DL")
+    endif()
+    unset(GGML_SYCL_SEPARATE_BUILD_CXX_PATH CACHE)
+    find_program(GGML_SYCL_SEPARATE_BUILD_CXX_PATH ${GGML_SYCL_SEPARATE_BUILD_CXX})
+    if (NOT GGML_SYCL_SEPARATE_BUILD_CXX_PATH)
+        message(FATAL_ERROR "GGML_SYCL_SEPARATE_BUILD_CXX: ${GGML_SYCL_SEPARATE_BUILD_CXX} not found")
+    endif()
+
+    # select the minimal possible build because we only need one backend
+    set(sycl_args
+        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
+        -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
+        -DCMAKE_CXX_COMPILER=${GGML_SYCL_SEPARATE_BUILD_CXX_PATH}
+        -DCMAKE_SKIP_BUILD_RPATH=ON
+        -DBUILD_SHARED_LIBS=ON
+        -DGGML_BACKEND_DL=ON
+        -DGGML_CPU=OFF
+        -DGGML_BUILD_TESTS=OFF
+        -DGGML_BUILD_EXAMPLES=OFF
+        -DGGML_CCACHE=${GGML_CCACHE})
+    if (CMAKE_CXX_COMPILER_LAUNCHER) # support when ccache or similar program passed as launcher
+        list(APPEND sycl_args -DCMAKE_C_COMPILER_LAUNCHER=${CMAKE_C_COMPILER_LAUNCHER} -DCMAKE_CXX_COMPILER_LAUNCHER=${CMAKE_CXX_COMPILER_LAUNCHER})
+    endif()
+
+    # append everything starting with GGML_SYCL to the flags
+    get_cmake_property(cache_vars CACHE_VARIABLES)
+    foreach (var ${cache_vars})
+        if (var MATCHES "^GGML_SYCL" AND NOT var MATCHES "^GGML_SYCL_SEPARATE_BUILD")
+            list(APPEND sycl_args -D${var}=${${var}})
+        endif()
+    endforeach()
+
+    set(sycl_lib ${CMAKE_SHARED_MODULE_PREFIX}ggml-sycl${CMAKE_SHARED_MODULE_SUFFIX})
+    set(sycl_out ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/${sycl_lib})
+
+    # ggml is not built standalone here, so use a wrapper project
+    set(sycl_src ${CMAKE_CURRENT_BINARY_DIR}/nested-src)
+    file(WRITE ${sycl_src}/CMakeLists.txt
+        "cmake_minimum_required(VERSION ${CMAKE_VERSION})\n"
+        "project(ggml-sycl-nested C CXX)\n"
+        "add_subdirectory(\"${CMAKE_CURRENT_SOURCE_DIR}/../..\" ggml)\n")
+
+    include(ExternalProject)
+    ExternalProject_Add(ggml-sycl
+        SOURCE_DIR ${sycl_src}
+        BINARY_DIR ${CMAKE_CURRENT_BINARY_DIR}/nested
+        CMAKE_ARGS ${sycl_args}
+        BUILD_COMMAND ${CMAKE_COMMAND} --build . --target ggml-sycl
+        BUILD_ALWAYS ON
+        BUILD_BYPRODUCTS ${sycl_out}
+        INSTALL_COMMAND ${CMAKE_COMMAND} -E copy_if_different <BINARY_DIR>/bin/${sycl_lib} ${sycl_out})
+    add_dependencies(ggml ggml-sycl)
+
+    if (GGML_BACKEND_DIR)
+        install(PROGRAMS ${sycl_out} DESTINATION ${GGML_BACKEND_DIR})
+    else()
+        install(PROGRAMS ${sycl_out} DESTINATION ${CMAKE_INSTALL_BINDIR})
+    endif()
+    return()
+endif()
+
+# icpx links temporary objects that are deleted afterwards, so the linker depfile makes ggml-sycl always out of date
+set(CMAKE_LINK_DEPENDS_USE_LINKER OFF)
+
 check_cxx_compiler_flag("-fsycl" SUPPORTS_SYCL)
 
 if (DEFINED ENV{ONEAPI_ROOT})

From 969134d948d4bcfb967d3aaeea08274378a66dc2 Mon Sep 17 00:00:00 2001
From: Alibek Omarov <a1ba.omarov@gmail.com>
Date: Sat, 26 Sep 2026 02:10:42 +0500
Subject: [PATCH 2/3] ggml: sycl: fix SYCL_DNNL flag report

CMakeLists define GGML_SYCL_DNNL as 0 or 1 and everywhere the check is performed with proper #if GGML_SYCL_DNNL. Only the banner message checks whether GGML_SYCL_DNNL is defined, showing a misleading message when oneDNN support was deliberately disabled.

Original ggml PR: https://github.com/ggml-org/ggml/pull/1646
---
 ggml/src/ggml-sycl/ggml-sycl.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index 99ebdb3e151d..90e0061573e3 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -394,7 +394,7 @@ static void ggml_check_sycl() try {
         GGML_SYCL_DEBUG("[SYCL] call ggml_check_sycl\n");
 
         GGML_LOG_INFO("Build with Macros:\n");
-#if defined(GGML_SYCL_DNNL)
+#if GGML_SYCL_DNNL
         GGML_LOG_INFO("  GGML_SYCL_DNNL: yes\n");
 #else
         GGML_LOG_INFO("  GGML_SYCL_DNNL: no\n");
@@ -444,7 +444,7 @@ static void ggml_check_sycl() try {
                       g_ggml_sycl_get_mem_api, mem_api_int2str(g_ggml_sycl_get_mem_api));
 #endif
 
-#if defined(GGML_SYCL_DNNL)
+#if GGML_SYCL_DNNL
         GGML_LOG_INFO("  GGML_SYCL_ENABLE_DNN: %d\n", g_ggml_sycl_enable_dnn);
         GGML_LOG_INFO("  GGML_SYCL_FA_ONEDNN: %d\n", g_ggml_sycl_fa_onednn);
 #else

From bfb6783539da6ee5bd5a2fd2a69290d3dffc8273 Mon Sep 17 00:00:00 2001
From: Alibek Omarov <a1ba.omarov@gmail.com>
Date: Wed, 7 Oct 2026 22:39:39 +0500
Subject: [PATCH 3/3] docs: SYCL: document new flags and provide examples for
 backend mix configuration

Signed-off-by: Alibek Omarov <a1ba.omarov@gmail.com>
---
 docs/backend/SYCL.md | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/docs/backend/SYCL.md b/docs/backend/SYCL.md
index f9da1ab3edbb..34817b7c5398 100644
--- a/docs/backend/SYCL.md
+++ b/docs/backend/SYCL.md
@@ -335,6 +335,39 @@ It is possible to come across some precision issues when running tests that stem
 instructions, which can be circumvented by setting the environment variable `SYCL_PROGRAM_COMPILE_OPTIONS`
 as `-cl-fp32-correctly-rounded-divide-sqrt`
 
+#### Mix SYCL with other backends
+
+By default the whole project is built with the SYCL compiler (`icx`/`icpx`), which prevents building other
+backends that need a different compiler, such as ROCm (`hipcc`).
+
+With `GGML_SYCL_SEPARATE_BUILD=ON`, only the SYCL backend is built with the SYCL compiler in a nested CMake project.
+The rest of the project uses the compiler you choose, and each backend is built as a dynamically loadable library,
+so SYCL can be used together with other backends, e.g. ROCm or Vulkan.
+
+This needs two options in addition to `GGML_SYCL=ON`:
+
+- `-DGGML_SYCL_SEPARATE_BUILD=ON`
+- `-DGGML_BACKEND_DL=ON` (required, the configuration would fail without it)
+
+```sh
+# Export relevant ENV variables
+source /opt/intel/oneapi/setvars.sh
+
+# Option 1: SYCL + Vulkan: the rest of the project is built with the default system compiler
+cmake -B build -DGGML_BACKEND_DL=ON -DGGML_SYCL=ON -DGGML_SYCL_SEPARATE_BUILD=ON -DGGML_VULKAN=ON
+
+# Option 2: SYCL + ROCm: HIPCXX is set explicitly, so the ROCm compiler is not confused with the clang shipped with oneAPI
+HIPCXX="$(hipconfig -l)/clang" HIP_PATH="$(hipconfig -R)" \
+	cmake -B build -DGGML_BACKEND_DL=ON -DGGML_SYCL=ON -DGGML_SYCL_SEPARATE_BUILD=ON -DGGML_HIP=ON
+
+# build all binary
+cmake --build build --config Release -j -v
+```
+
+You can use `-DGGML_SYCL_SEPARATE_BUILD_CXX=<compiler>` to choose another SYCL C++ compiler than `icpx`.
+Other backends are enabled with their usual options, and all of them are listed by `--list-devices` at runtime.
+Builds without `GGML_SYCL_SEPARATE_BUILD` are not affected.
+
 ### III. Run the inference
 
 #### Retrieve and prepare model
@@ -781,10 +814,13 @@ User can use the device management in [docs/multi-gpu.md](https://github.com/ggm
 | GGML_SYCL_DNN      | ON *(default)* \|OFF *(Optional)*     | Enable build with oneDNN.                   |
 | GGML_SYCL_HOST_MEM_FALLBACK | ON *(default)* \|OFF *(Optional)* | Allow host memory fallback when device memory is full during quantized weight reorder. Enables inference to continue at reduced speed (reading over PCIe) instead of failing. Requires Linux kernel 6.8+. |
 | GGML_SYCL_SUPPORT_LEVEL_ZERO_API | ON *(default)* \|OFF *(Optional)* | Support to use Level Zero API for device memory allocation. Requires Level Zero headers/library at build time and Intel GPU driver (Level Zero runtime) at run time. Reduces system RAM usage during multi-GPU inference. SYCL backend always runs on Level Zero running time even if it's set as OFF (The SYCL api will be usage for memory allocation).|
+| GGML_SYCL_SEPARATE_BUILD | OFF *(default)* \|ON *(optional)* | Build in a nested project with its own C++ compiler, so the rest can use another compiler such as GCC or hipcc. Requires `GGML_BACKEND_DL=ON`. (2.) |
+| GGML_SYCL_SEPARATE_BUILD_CXX | `icpx` *(default)* | C++ compiler used for the nested SYCL project when `GGML_SYCL_SEPARATE_BUILD=ON`. |
 | CMAKE_C_COMPILER   | `icx` *(Linux)*, `icx/cl` *(Windows)* | Set `icx` compiler for SYCL code path.      |
 | CMAKE_CXX_COMPILER | `icpx` *(Linux)*, `icx` *(Windows)*   | Set `icpx/icx` compiler for SYCL code path. |
 
 1. FP32 or FP16 have different performance impact to LLM. Recommended to test them for better prompt processing performance on your models. You need to rebuild the code after change `GGML_SYCL_F16=OFF/ON`.
