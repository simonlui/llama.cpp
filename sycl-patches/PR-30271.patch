From 182b83ef19635ed181354888ede45946b2b60284 Mon Sep 17 00:00:00 2001
From: Michael Taylor <162068037+mctylr-gh@users.noreply.github.com>
Date: Fri, 9 Oct 2026 22:49:39 -0300
Subject: [PATCH 5/7] sycl: fattn-common - replace deprecated
 parallel_for(properties) overload

`parallel_for(range, properties, kernel)`, used to advertise the Intel
`grf_size_automatic` property for the flash-attention kernels, is
deprecated in SYCL 2020. The recommended replacements are a
`launch_config` object or a kernel *functor* with a `get(properties_tag)`
member. `launch_config` cannot carry `grf_size` (it static_asserts against
properties that have a compile-time kernel effect), so the kernel is
wrapped in a functor that advertises the property through the
properties_tag getter.

- add `grf_size_kernel<KernelFunc, warp_size>`: a kernel functor that
  forwards to the kernel lambda and returns `grf_size_automatic` from a
  `const get(properties_tag)` member
- `lauch_kernel`: use `grf_size_kernel` in the `use_large_grf` branch instead
  of the deprecated overload; the `use_large_grf = false` branch is unchanged
- the `reqd_sub_group_size` attribute is also placed on the functor operator()
  it is written at the start of the declaration because icpx rejects it
  after the const qualifier

Assisted-by: pi (unsloth/Qwen3.8-27B-GGUF:Q4_K_M via llama.cpp)
---
 ggml/src/ggml-sycl/fattn-common.hpp | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-sycl/fattn-common.hpp b/ggml/src/ggml-sycl/fattn-common.hpp
index 2e8ac6af3fc8..9d732d1aaba9 100644
--- a/ggml/src/ggml-sycl/fattn-common.hpp
+++ b/ggml/src/ggml-sycl/fattn-common.hpp
@@ -832,6 +832,21 @@ static void flash_attn_combine_results(const float * __restrict__ VKQ_parts,
     dst[tid] = VKQ_numerator / VKQ_denominator;
 }
 
+// Advertises grf_size_automatic via the properties_tag getter, replacing the
+// deprecated parallel_for(range, properties, kernel) overload.
+template <typename KernelFunc, int warp_size>
+struct grf_size_kernel {
+    KernelFunc kernel;
+
+    [[sycl::reqd_sub_group_size(warp_size)]] void operator()(sycl::nd_item<3> item) const {
+        kernel(item);
+    }
+
+    auto get(sycl::ext::oneapi::experimental::properties_tag) const {
+        return sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size_automatic };
+    }
+};
+
 template <fattn_kernel_t fattn_kernel, int warp_size, bool use_large_grf = false>
 static void lauch_kernel(
     dpct::dim3 group_range,
@@ -893,10 +908,7 @@ static void lauch_kernel(
     q->submit([&](sycl::handler &cgh) {
         // grf_size_automatic lets the compiler use the large register file when the kernel needs it. grf_size<256> would say the same but is undefined on devices that do not have it.
         if constexpr (use_large_grf) {
-            cgh.parallel_for(
-                rng,
-                sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size_automatic },
-                kernel);
+            cgh.parallel_for(rng, grf_size_kernel<decltype(kernel), warp_size>{kernel});
         } else {
             cgh.parallel_for(rng, kernel);
         }

From 40b0e8592f845c8bec24126e81d9a08cbdca7c29 Mon Sep 17 00:00:00 2001
From: Michael Taylor <162068037+mctylr-gh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 00:56:47 -0300
Subject: [PATCH 6/7] SYCL: fattn-common - express reqd_sub_group_size as a
 kernel property

The kernel carried both the `reqd_sub_group_size` attribute and a kernel
property (`grf_size_automatic`), which icpx flags with
`-Wignored-attributes`. The oneAPI kernel-properties framework already
provides `sub_group_size`, so move the sub-group size from the attribute
into the same get(properties_tag) object that carries
`grf_size_automatic`.

- rename `grf_size_kernel` to `props_kernel<KernelFunc, Size, UseGrf>;` the
  sub-group size is now a property (`sub_group_size<Size>`) returned from
  the   `const get(properties_tag)` member, and `grf_size_automatic` is
  added only when `UseGrf` is true
- drop the `reqd_sub_group_size` attribute from the kernel lambda and the
  functor operator(); no attribute remains on the kernel
- `lauch_kernel`: collapse the `use_large_grf` branch into a single
  `parallel_for(rng, props_kernel<..., use_large_grf>{kernel})`

No behaviour change: on-device (bmg-g31) the property applies the same
sub-group size as the attribute (16), versus 32 by default.

Assisted-by: pi (unsloth/Qwen3.8-27B-GGUF:Q4_K_M via llama.cpp)
---
 ggml/src/ggml-sycl/fattn-common.hpp | 28 ++++++++++++++++------------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/ggml/src/ggml-sycl/fattn-common.hpp b/ggml/src/ggml-sycl/fattn-common.hpp
index 9d732d1aaba9..c37326336db1 100644
--- a/ggml/src/ggml-sycl/fattn-common.hpp
+++ b/ggml/src/ggml-sycl/fattn-common.hpp
@@ -832,18 +832,26 @@ static void flash_attn_combine_results(const float * __restrict__ VKQ_parts,
     dst[tid] = VKQ_numerator / VKQ_denominator;
 }
 
-// Advertises grf_size_automatic via the properties_tag getter, replacing the
-// deprecated parallel_for(range, properties, kernel) overload.
-template <typename KernelFunc, int warp_size>
-struct grf_size_kernel {
+// Carries the sub-group size (and grf_size_automatic when use_large_grf) as
+// kernel properties via get(properties_tag), in place of the
+// reqd_sub_group_size attribute and the deprecated parallel_for overload.
+template <typename KernelFunc, uint32_t Size, bool UseGrf>
+struct props_kernel {
     KernelFunc kernel;
 
-    [[sycl::reqd_sub_group_size(warp_size)]] void operator()(sycl::nd_item<3> item) const {
+    void operator()(sycl::nd_item<3> item) const {
         kernel(item);
     }
 
     auto get(sycl::ext::oneapi::experimental::properties_tag) const {
-        return sycl::ext::oneapi::experimental::properties{ sycl::ext::intel::experimental::grf_size_automatic };
+        if constexpr (UseGrf) {
+            return sycl::ext::oneapi::experimental::properties{
+                sycl::ext::intel::experimental::grf_size_automatic,
+                sycl::ext::oneapi::experimental::sub_group_size<Size> };
+        } else {
+            return sycl::ext::oneapi::experimental::properties{
+                sycl::ext::oneapi::experimental::sub_group_size<Size> };
+        }
     }
 };
 
@@ -896,7 +904,7 @@ static void lauch_kernel(
         static_cast<sycl::range<3>>(group_range * local_range),
         static_cast<sycl::range<3>>(local_range));
 
-    const auto kernel = [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(warp_size)]] {
+    const auto kernel = [=](sycl::nd_item<3> item_ct1) {
         GGML_UNUSED(item_ct1);
         fattn_kernel(Q, K, V, mask, sinks, KV_max, dst, dst_meta, scale,
                      max_bias, m0, m1, n_head_log2, logit_softcap, ne00,
@@ -907,11 +915,7 @@ static void lauch_kernel(
 
     q->submit([&](sycl::handler &cgh) {
         // grf_size_automatic lets the compiler use the large register file when the kernel needs it. grf_size<256> would say the same but is undefined on devices that do not have it.
-        if constexpr (use_large_grf) {
-            cgh.parallel_for(rng, grf_size_kernel<decltype(kernel), warp_size>{kernel});
-        } else {
-            cgh.parallel_for(rng, kernel);
-        }
+        cgh.parallel_for(rng, props_kernel<decltype(kernel), warp_size, use_large_grf>{kernel});
     });
 }
 

