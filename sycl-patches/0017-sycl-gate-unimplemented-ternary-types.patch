+static bool ggml_sycl_type_has_no_kernels(ggml_type type) {
+    // The SYCL backend implements no kernel for the ternary types anywhere:
+    // set_rows.cpp, cpy.cpp and mmvq.cpp all reach a hard abort when one shows
+    // up (test-backend-ops exercises TQ2_0 through its all_types list). The
+    // per-op gates below only check operand types, so catch these centrally and
+    // let the scheduler fall back to CPU. Drop a type from here when real
+    // kernels land for it.
+    return type == GGML_TYPE_TQ1_0 || type == GGML_TYPE_TQ2_0;
+}
