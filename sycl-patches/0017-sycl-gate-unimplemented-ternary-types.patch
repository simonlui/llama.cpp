+        case GGML_OP_TRANSPOSE:
+            break;
+        default:
+            if (ggml_sycl_type_has_no_kernels(op->type)) {
+                return false;
+            }
+            for (int i = 0; i < GGML_MAX_SRC; ++i) {
+                if (op->src[i] && ggml_sycl_type_has_no_kernels(op->src[i]->type)) {
+                    return false;
+                }
+            }
+            break;
+    }
