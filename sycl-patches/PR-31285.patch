+        auto it = g_ggml_sycl_dev_allocs.find(ptr);
+        if (it != g_ggml_sycl_dev_allocs.end()) {
+            const int device = it->second.first;
+            g_ggml_sycl_dev_alloc_bytes[device] -= it->second.second;
