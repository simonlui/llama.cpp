+#ifndef GGML_SYCL_FUSED_ADD_HPP
+#define GGML_SYCL_FUSED_ADD_HPP
+
+#include "common.hpp"
+
+// dst = experts[:, 0] * w[0] + ... + experts[:, k - 1] * w[k - 1] per token, w = expert_scale * weights: the MUL by
+// the router weights and the chain of k - 1 ADDs that sums the expert outputs of a MoE layer, in one launch
+// (ported from ggml_cuda_op_moe_weighted_reduction)
+void ggml_sycl_op_moe_weighted_reduction(ggml_backend_sycl_context & ctx, const ggml_tensor * experts,
+                                         const ggml_tensor * expert_scale, const ggml_tensor * weights,
+                                         ggml_tensor * dst);
+
+// adds[0..n_adds) is a chain of same-shape, contiguous F32 ADDs, each consuming the previous one as src[0]:
+// one launch writes the last one, summing in the order the separate ADDs would
+void ggml_sycl_op_multi_add(ggml_backend_sycl_context & ctx, ggml_tensor * const * adds, int n_adds);
+
+#endif  // GGML_SYCL_FUSED_ADD_HPP
