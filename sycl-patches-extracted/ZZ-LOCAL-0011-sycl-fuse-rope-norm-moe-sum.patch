+// RMS_NORM + MUL + ROPE (+ VIEW + SET_ROWS), ported from CUDA's rms_norm_mul_rope_f32: one sub-group per
+// (head, token) row. The norm sums the row in the same order as the single-sub-group rms_norm kernel,
+// then each work-item scales, weights and rotates the pairs it owns, writing straight into the KV cache
+// row when a SET_ROWS follows.
+template <bool has_ff, bool is_neox, typename D>
+static void rms_norm_mul_rope_f32(const float * x, D * dst, const int ncols, const int64_t s01, const int64_t s02,
+                                  const int64_t s03, const int64_t s1, const int64_t s2, const int64_t s3,
+                                  const float eps, const float * mul, const int64_t mul_s01, const int64_t mul_s02,
+                                  const int64_t mul_s03, const int mul_nrows, const int mul_nchannels,
+                                  const int mul_nsamples, const int n_dims, const int32_t * pos,
+                                  const float freq_scale, const float ext_factor, const float attn_factor,
+                                  const rope_corr_dims corr_dims, const float theta_scale, const float * freq_factors,
+                                  const int64_t * row_indices, const int64_t set_rows_stride,
+                                  const sycl::nd_item<3> & it) {
+    const int sample  = it.get_group(0);
+    const int channel = it.get_group(1);
+    const int row     = it.get_group(2);
+    const int tid     = it.get_local_id(2);
+
+    const float * xc   = x + sample * s03 + channel * s02 + row * s01;
+    const float * mulc = mul + (sample % mul_nsamples) * mul_s03 + (channel % mul_nchannels) * mul_s02 +
+                         (row % mul_nrows) * mul_s01;
+
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += WARP_SIZE) {
+        const float xi = xc[col];
+        tmp += xi * xi;
+    }
+    tmp = warp_reduce_sum(tmp, it);
+
+    const float mean  = tmp / ncols;
+    const float scale = sycl::rsqrt(mean + eps);
+
+    int64_t idst = sample * s3 + channel * s2 + row * s1;
+    if (set_rows_stride != 0) {
+        idst = row * s1 + row_indices[channel] * set_rows_stride;
+    }
+    D * dstc = dst + idst;
+
+    for (int i0 = 2 * tid; i0 < ncols; i0 += 2 * WARP_SIZE) {
+        int ix0 = i0;
+        int ix1 = i0 + 1;
+        if (is_neox && i0 < n_dims) {
+            ix0 = i0 / 2;
+            ix1 = i0 / 2 + n_dims / 2;
+        }
+
+        const float x0 = scale * xc[ix0] * mulc[ix0];
+        const float x1 = scale * xc[ix1] * mulc[ix1];
+
+        if (i0 >= n_dims) {
+            dstc[ix0] = ggml_sycl_cast<D>(x0);
+            dstc[ix1] = ggml_sycl_cast<D>(x1);
+            continue;
+        }
+
+        const float theta_base  = pos[channel] * dpct::pow(theta_scale, i0 / 2.0f);
+        const float freq_factor = has_ff ? freq_factors[i0 / 2] : 1.0f;
+
+        float cos_theta;
+        float sin_theta;
+        rope_yarn<true>(theta_base / freq_factor, freq_scale, corr_dims, i0, ext_factor, attn_factor, cos_theta,
+                        sin_theta);
+
+        dstc[ix0] = ggml_sycl_cast<D>(x0 * cos_theta - x1 * sin_theta);
+        dstc[ix1] = ggml_sycl_cast<D>(x0 * sin_theta + x1 * cos_theta);
+    }
+}
