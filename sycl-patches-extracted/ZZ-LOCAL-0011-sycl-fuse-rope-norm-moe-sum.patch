+// false when a node the fused group writes overlaps a source it reads that is not one of the group's own
+// intermediates (ported from ggml_cuda_check_fusion_memory_ranges)
+bool ggml_sycl_fusion_ranges_ok(const ggml_cgraph * cgraph, int node_idx, int node_count, const int * out_nodes,
+                                int out_count) {
+    auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const int64_t a_start = (int64_t) a->data;
+        const int64_t a_end   = a_start + ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+        const int64_t b_start = (int64_t) b->data;
+        const int64_t b_end   = b_start + ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+        return (b_start <= a_start && a_start < b_end) || (a_start <= b_start && b_start < a_end);
+    };
+
+    for (int i = 0; i < out_count; ++i) {
+        const ggml_tensor * dst = cgraph->nodes[out_nodes[i]];
+        for (int j = node_idx; j < node_idx + node_count; ++j) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                const ggml_tensor * src = cgraph->nodes[j]->src[s];
+                if (!src || src->op == GGML_OP_NONE || !overlap(dst, src)) {
+                    continue;
+                }
+                bool intermediate = false;
+                for (int k = node_idx; k < j; ++k) {
+                    intermediate = intermediate || cgraph->nodes[k] == src;
+                }
+                if (!intermediate) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+// ROPE -> VIEW -> SET_ROWS: the rope kernels' set_rows path (ported from ggml_cuda_should_fuse_rope_set_rows)
+static bool ggml_sycl_should_fuse_rope_set_rows(const ggml_tensor * rope, const ggml_tensor * view,
+                                                const ggml_tensor * set_rows) {
+    if (rope->op != GGML_OP_ROPE || view->op != GGML_OP_VIEW || set_rows->op != GGML_OP_SET_ROWS) {
+        return false;
+    }
+    if (view->src[0] != rope || set_rows->src[0] != view) {
+        return false;
+    }
+    // the kernels index the cache row by the token (ne[2]) only
+    if (rope->src[0]->ne[3] != 1) {
+        return false;
+    }
+    // the set_rows path of the rope kernels reads f32 and writes f32 or f16
+    if (rope->src[0]->type != GGML_TYPE_F32 || rope->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (set_rows->type != GGML_TYPE_F32 && set_rows->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (set_rows->src[1]->type != GGML_TYPE_I64 || set_rows->src[1]->ne[0] != rope->ne[2] ||
+        set_rows->nb[0] != ggml_type_size(set_rows->type)) {
+        return false;
+    }
+    // the view flattens the heads of a token into one cache row
+    if (!ggml_is_contiguous(view) || view->ne[0] != rope->ne[0] * rope->ne[1]) {
+        return false;
+    }
+    // the rope kernels compute the destination index in 32 bits
+    if (ggml_nelements(set_rows) > INT32_MAX) {
+        return false;
+    }
+    // only the norm / neox kernels take the set_rows destination
+    const int mode = ggml_get_op_params_i32(rope, 2);
+    return mode == GGML_ROPE_TYPE_NORMAL || mode == GGML_ROPE_TYPE_NEOX;
+}
+
+// RMS_NORM -> MUL -> ROPE (ported from ggml_cuda_should_fuse_rms_norm_mul_rope)
+static bool ggml_sycl_should_fuse_rms_norm_mul_rope(const ggml_tensor * rms_norm, const ggml_tensor * mul,
+                                                    const ggml_tensor * rope) {
+    if (rms_norm->op != GGML_OP_RMS_NORM || mul->op != GGML_OP_MUL || rope->op != GGML_OP_ROPE) {
+        return false;
+    }
+    if (rms_norm->src[0]->type != GGML_TYPE_F32 || rms_norm->type != GGML_TYPE_F32 ||
+        mul->src[0]->type != GGML_TYPE_F32 || mul->src[1]->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+        rope->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (rope->src[0] != mul || (mul->src[0] != rms_norm && mul->src[1] != rms_norm)) {
+        return false;
+    }
+    if (!ggml_are_same_shape(rms_norm, mul)) {
+        return false;
+    }
+    // the kernel reads the weight as w[col] of a row it may broadcast over heads, tokens and samples
+    const ggml_tensor * w = mul->src[0] == rms_norm ? mul->src[1] : mul->src[0];
+    if (w->ne[0] != rms_norm->ne[0] || w->nb[0] != ggml_type_size(w->type)) {
+        return false;
+    }
+    if (rms_norm->src[0]->nb[0] != ggml_type_size(rms_norm->src[0]->type)) {
+        return false;
+    }
+    const int mode = ggml_get_op_params_i32(rope, 2);
+    if (mode != GGML_ROPE_TYPE_NORMAL && mode != GGML_ROPE_TYPE_NEOX) {
+        return false;
+    }
+    const int n_dims = ggml_get_op_params_i32(rope, 1);
+    if (n_dims % 2 != 0 || rope->ne[0] % 2 != 0 || n_dims > rope->ne[0]) {
+        return false;
+    }
+    // ggml_rope_set_offset is not handled by the fused kernel
+    return ggml_get_op_params_i32(rope, 15) == 0;
+}
+
+// MUL(experts, router weights) [* MUL(expert scale)] -> one VIEW per expert -> k - 1 ADDs: the expert sum of a
+// MoE layer (ported from ggml_cuda_match_moe_weighted_reduction; the views and ADDs may interleave)
+bool ggml_sycl_match_moe_weighted_reduction(const ggml_cgraph * cgraph, int node_idx,
+                                            ggml_sycl_moe_reduction_match & match) {
+    if (!g_ggml_sycl_enable_fusion) {
+        return false;
+    }
+    const ggml_tensor * first = cgraph->nodes[node_idx];
+    if (first->op != GGML_OP_MUL || first->type != GGML_TYPE_F32 || !ggml_is_contiguous(first)) {
+        return false;
+    }
+
+    auto split_mul = [](const ggml_tensor * mul, const ggml_tensor *& full, const ggml_tensor *& broadcast) {
+        auto is_weights = [mul](const ggml_tensor * t) {
+            return t && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->ne[0] == 1 && t->ne[1] == mul->ne[1] &&
+                   t->ne[2] == mul->ne[2] && t->ne[3] == mul->ne[3];
+        };
+        auto is_experts = [mul](const ggml_tensor * t) {
+            return t && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && ggml_are_same_shape(t, mul);
+        };
+        if (is_experts(mul->src[0]) && is_weights(mul->src[1])) {
+            full      = mul->src[0];
+            broadcast = mul->src[1];
+            return true;
+        }
+        if (is_experts(mul->src[1]) && is_weights(mul->src[0])) {
+            full      = mul->src[1];
+            broadcast = mul->src[0];
+            return true;
+        }
+        return false;
+    };
+
+    const ggml_tensor * weighted     = first;
+    const ggml_tensor * experts      = nullptr;
+    const ggml_tensor * expert_scale = nullptr;
+    const ggml_tensor * weights      = nullptr;
+    int                 mul_count    = 1;
+
+    // (experts * expert_scale) * router_weight, or experts * router_weight
+    if (node_idx + 1 < cgraph->n_nodes) {
+        const ggml_tensor * second = cgraph->nodes[node_idx + 1];
+        const ggml_tensor * scaled = nullptr;
+        const ggml_tensor * route  = nullptr;
+        const ggml_tensor * raw    = nullptr;
+        const ggml_tensor * scale  = nullptr;
+        if (second->op == GGML_OP_MUL && second->type == GGML_TYPE_F32 && ggml_is_contiguous(second) &&
+            split_mul(second, scaled, route) && scaled == first && split_mul(first, raw, scale)) {
+            weighted     = second;
+            experts      = raw;
+            expert_scale = scale;
+            weights      = route;
+            mul_count    = 2;
+        }
+    }
+    if (experts == nullptr && !split_mul(first, experts, weights)) {
+        return false;
+    }
+
+    const int     n_expert_used = (int) weighted->ne[1];
+    const int64_t n_tokens      = weighted->ne[2] * weighted->ne[3];
+    if (n_expert_used < 2 || n_expert_used > GGML_SYCL_MOE_REDUCTION_MAX_EXPERTS) {
+        return false;
+    }
+    const int node_count = 2 * n_expert_used + mul_count - 1;
+    if (node_idx + node_count > cgraph->n_nodes) {
+        return false;
+    }
+
+    std::vector<ggml_op> ops(node_count, GGML_OP_VIEW);
+    ops[0] = GGML_OP_MUL;
+    if (mul_count == 2) {
+        ops[1] = GGML_OP_MUL;
+    }
+    std::vector<const ggml_tensor *> views;
+    views.reserve(n_expert_used);
+    const ggml_tensor * previous = nullptr;
+    int                 n_adds   = 0;
+    for (int offset = mul_count; offset < node_count; ++offset) {
+        const ggml_tensor * c = cgraph->nodes[node_idx + offset];
+        ops[offset]           = c->op;
+        if (c->op == GGML_OP_VIEW) {
+            const int expert = (int) views.size();
+            if (expert >= n_expert_used || c->src[0] != weighted || c->view_src != weighted ||
+                c->type != GGML_TYPE_F32 || c->ne[0] != weighted->ne[0] || c->ne[1] != n_tokens || c->ne[2] != 1 ||
+                c->ne[3] != 1 || c->nb[0] != weighted->nb[0] || c->nb[1] != weighted->nb[2] ||
+                c->view_offs != (size_t) expert * weighted->nb[1]) {
+                return false;
+            }
+            views.push_back(c);
+            continue;
+        }
+        if (c->op != GGML_OP_ADD || views.size() < 2 || n_adds + 1 >= (int) views.size()) {
+            return false;
+        }
+        const ggml_tensor * lhs = n_adds == 0 ? views[0] : previous;
+        const ggml_tensor * rhs = views[n_adds + 1];
+        if (c->src[0] != lhs || c->src[1] != rhs || c->type != GGML_TYPE_F32) {
+            return false;
+        }
+        previous = c;
+        ++n_adds;
+    }
+    if ((int) views.size() != n_expert_used || n_adds != n_expert_used - 1 || previous == nullptr) {
+        return false;
+    }
+    if (!ggml_is_contiguous(previous) || previous->ne[0] != weighted->ne[0] || previous->ne[1] != n_tokens ||
+        previous->ne[2] != 1 || previous->ne[3] != 1) {
+        return false;
+    }
+
+    const int output_idx = node_idx + node_count - 1;
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx, node_count, ops.data(), &output_idx, 1)) {
+        return false;
+    }
+
+    match.experts      = experts;
+    match.expert_scale = expert_scale;
+    match.weights      = weights;
+    match.dst          = cgraph->nodes[output_idx];
+    match.node_count   = node_count;
+    return true;
+}
+
+// a chain of 3..8 same-shape contiguous F32 ADDs, each consuming the previous as src[0] (the CUDA and Vulkan
+// multi-add; pairs keep the broadcasting ADD + ADD kernel). Every work-item reads all operands at its own index
+// before writing it, so an operand may share the destination's memory only at the same address.
+int ggml_sycl_match_multi_add(const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion) {
+        return 0;
+    }
+    constexpr int max_adds = 8;
+    ggml_op       ops[max_adds];
+    std::fill(ops, ops + max_adds, GGML_OP_ADD);
+
+    auto operand_ok = [](const ggml_tensor * t, const ggml_tensor * ref) {
+        return t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && ggml_are_same_shape(t, ref);
+    };
+
+    const ggml_tensor * first = cgraph->nodes[node_idx];
+    if (first->op != GGML_OP_ADD || !operand_ok(first, first) || !operand_ok(first->src[0], first) ||
+        !operand_ok(first->src[1], first) || ggml_nelements(first) >= ((int64_t) 1 << 31)) {
+        return 0;
+    }
+    int n = 1;
+    while (n < max_adds && ggml_can_fuse(cgraph, node_idx, ops, n + 1)) {
+        const ggml_tensor * next = cgraph->nodes[node_idx + n];
+        if (next->src[0] != cgraph->nodes[node_idx + n - 1] || !operand_ok(next, first) ||
+            !operand_ok(next->src[1], first)) {
+            break;
+        }
+        ++n;
+    }
+    if (n < 3) {
+        return 0;
+    }
+
+    const ggml_tensor * dst  = cgraph->nodes[node_idx + n - 1];
+    const size_t        size = ggml_nbytes(dst);
+    auto disjoint_or_same = [&](const ggml_tensor * t) {
+        const char * a = (const char *) t->data;
+        const char * b = (const char *) dst->data;
+        return a == b || a + ggml_nbytes(t) <= b || b + size <= a;
+    };
+    if (!disjoint_or_same(first->src[0])) {
+        return 0;
+    }
+    for (int j = 0; j < n; ++j) {
+        if (!disjoint_or_same(cgraph->nodes[node_idx + j]->src[1])) {
+            return 0;
+        }
+    }
+    return n;
+}
+
 // the unary ops the fused unary chains in element_wise.cpp have a functor for
 static bool ggml_sycl_fused_unary_has_kernel(ggml_unary_op unary_op) {
     return unary_op == GGML_UNARY_OP_SILU || unary_op == GGML_UNARY_OP_SIGMOID ||
@@ -121,10 +405,38 @@ bool ggml_sycl_can_fuse(const ggml_cgraph * cgraph, int node_idx, std::initializ
         return ggml_sycl_should_fuse_mul_mat_glu(gate, up, glu);
     }
 
+    if (ops.size() == 5 && ops.begin()[0] == GGML_OP_RMS_NORM && ops.begin()[1] == GGML_OP_MUL &&
+        ops.begin()[2] == GGML_OP_ROPE && ops.begin()[3] == GGML_OP_VIEW && ops.begin()[4] == GGML_OP_SET_ROWS) {
