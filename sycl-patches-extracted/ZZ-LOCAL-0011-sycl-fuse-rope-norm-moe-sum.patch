Subject: [PATCH] sycl: port the RoPE / norm, MoE expert-sum, ADD-chain and biased top-k MoE fusions

Local port of graph fusions CUDA, Vulkan and Metal run and SYCL did not:

- ROPE -> VIEW -> SET_ROWS: the rope kernels already had a set_rows destination
  (ggml_sycl_rope_fused) that nothing called. The predicate is CUDA's
  ggml_cuda_should_fuse_rope_set_rows, limited to what the SYCL kernels take: f32 in, f32 / f16 cache,
  I64 row ids, the norm and neox modes, and a cache whose element index fits 32 bits.
- RMS_NORM -> MUL -> ROPE (-> VIEW -> SET_ROWS): the Q / K norms of Qwen3, Gemma 3 and OLMo 2 in one
  launch, K written straight into the KV cache. Ported from CUDA's rms_norm_mul_rope_f32; one sub-group
  per (head, token) row sums the row in the order the one-sub-group rms_norm kernel does.
- MUL (router weights) [* MUL (expert scale)] -> one VIEW per expert -> k - 1 ADDs: the expert sum of a
  MoE layer in one kernel (CUDA's ggml_cuda_match_moe_weighted_reduction, Metal's moe_reduce), up to 15
  experts. graph_optimize keeps the expert results alive until the sum so its output cannot be placed
  over them.
- A chain of 3..8 same-shape contiguous F32 ADDs (CUDA / Vulkan multi-add); pairs and broadcasts keep
  the ADD + ADD kernel.
- topk-moe with a routing bias (sigmoid + bias, DeepSeek-V3 style): selection on probs + bias, weights
  from the probs, as CUDA's topk_moe_cuda<has_bias>. Expert-group masking and sqrt(softplus) gating are
  not ported and stay unfused.

Each fusion can be turned off with GGML_SYCL_ENABLE_FUSION=0 like the existing ones.

diff --git a/ggml/src/ggml-sycl/fused-add.cpp b/ggml/src/ggml-sycl/fused-add.cpp
new file mode 100644
index 00000000..6c8ad915
--- /dev/null
+++ b/ggml/src/ggml-sycl/fused-add.cpp
@@ -0,0 +1,89 @@
+#include "fused-add.hpp"
+
+static constexpr int GGML_SYCL_FUSED_ADD_BLOCK  = 256;
+static constexpr int GGML_SYCL_MULTI_ADD_MAX    = 8;
+
+void ggml_sycl_op_moe_weighted_reduction(ggml_backend_sycl_context & ctx, const ggml_tensor * experts,
+                                         const ggml_tensor * expert_scale, const ggml_tensor * weights,
+                                         ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/0, " : fused MoE weighted sum");
+    GGML_ASSERT(experts->type == GGML_TYPE_F32 && weights->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(expert_scale == nullptr || expert_scale->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(experts) && ggml_is_contiguous(weights) && ggml_is_contiguous(dst));
+    GGML_ASSERT(expert_scale == nullptr || ggml_is_contiguous(expert_scale));
+
+    const int64_t n_embd        = experts->ne[0];
+    const int     n_expert_used = (int) experts->ne[1];
+    const int64_t n_tokens      = experts->ne[2] * experts->ne[3];
+
+    const float * x     = (const float *) experts->data;
+    const float * scale = expert_scale ? (const float *) expert_scale->data : nullptr;
+    const float * w     = (const float *) weights->data;
+    float *       out   = (float *) dst->data;
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const int64_t n_col_blocks = (n_embd + GGML_SYCL_FUSED_ADD_BLOCK - 1) / GGML_SYCL_FUSED_ADD_BLOCK;
+    stream->parallel_for(
+        sycl::nd_range<2>(sycl::range<2>(n_tokens, n_col_blocks * GGML_SYCL_FUSED_ADD_BLOCK),
+                          sycl::range<2>(1, GGML_SYCL_FUSED_ADD_BLOCK)),
+        [=](sycl::nd_item<2> it) {
+            const int64_t token = it.get_global_id(0);
+            const int64_t col   = it.get_global_id(1);
+            if (col >= n_embd) {
+                return;
+            }
+            // the unfused graph rounds each product before the next ADD, in expert order
+            const int64_t first = token * n_expert_used;
+            float         sum   = (x[first * n_embd + col] * (scale ? scale[first] : 1.0f)) * w[first];
+            for (int e = 1; e < n_expert_used; ++e) {
+                const int64_t row = first + e;
+                sum += (x[row * n_embd + col] * (scale ? scale[row] : 1.0f)) * w[row];
+            }
+            out[token * n_embd + col] = sum;
+        });
+}
+
+namespace {
+struct multi_add_args {
+    const float * src[GGML_SYCL_MULTI_ADD_MAX + 1];
+};
+}  // namespace
+
+void ggml_sycl_op_multi_add(ggml_backend_sycl_context & ctx, ggml_tensor * const * adds, int n_adds) {
+    GGML_ASSERT(n_adds >= 2 && n_adds <= GGML_SYCL_MULTI_ADD_MAX);
+    ggml_tensor * dst = adds[n_adds - 1];
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/0, " : fused ADD chain");
+
+    multi_add_args args = {};
+    args.src[0] = (const float *) adds[0]->src[0]->data;
+    for (int i = 0; i < n_adds; ++i) {
+        GGML_ASSERT(i == 0 || adds[i]->src[0] == adds[i - 1]);
+        args.src[i + 1] = (const float *) adds[i]->src[1]->data;
+    }
+    float *       out = (float *) dst->data;
+    const int64_t n   = ggml_nelements(dst);
+    const int     nsrc = n_adds + 1;
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const int64_t n_blocks = (n + GGML_SYCL_FUSED_ADD_BLOCK - 1) / GGML_SYCL_FUSED_ADD_BLOCK;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_blocks * GGML_SYCL_FUSED_ADD_BLOCK), sycl::range<1>(GGML_SYCL_FUSED_ADD_BLOCK)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t i = it.get_global_id(0);
+            if (i >= n) {
+                return;
+            }
+            float acc = args.src[0][i];
+#pragma unroll
+            for (int s = 1; s < GGML_SYCL_MULTI_ADD_MAX + 1; ++s) {
+                if (s < nsrc) {
+                    acc += args.src[s][i];
+                }
+            }
+            out[i] = acc;
+        });
+}
