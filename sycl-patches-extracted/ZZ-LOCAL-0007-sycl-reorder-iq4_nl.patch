 static __dpct_inline__ void dequantize_q1_0_reorder(const void *d_ptr, const int64_t ib, const void *qs,
                                             const int iqs, dfloat2 &v) {
     // Q1_0 reorder layout: scale values followed by quantized bits
@@ -907,6 +917,32 @@ static void dequantize_block_q4_0_reorder_wide(const void * __restrict__ vx, dst
     *reinterpret_cast<sycl::vec<dst_t, 4> *>(yb + QK4_0/2) = hi.convert<dst_t, sycl::rounding_mode::automatic>();
 }
 
+// Dequantize IQ4_NL from reorder layout: [all qs (k/2 bytes)][all d values], four qs bytes per item
+template <typename dst_t>
+static void dequantize_block_iq4_nl_reorder_wide(const void * __restrict__ vx, dst_t * __restrict__ yy, int64_t k,
+                                                 const sycl::id<1> idx) {
+    const int64_t i   = (int64_t) idx[0];
+    const int64_t ib  = i / 4;
+    const int64_t iqs = 4 * (i % 4);
+
+    const uint8_t *    qs    = (const uint8_t *) vx;
+    const sycl::half * d_ptr = (const sycl::half *) ((const uint8_t *) vx + k/2);
+
+    const float     d = float(d_ptr[ib]);
+    const uint8_t * q = qs + ib*(QK4_NL/2) + iqs;
+
+    sycl::vec<float, 4> lo, hi;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        lo[j] = d * kvalues_iq4nl[q[j] & 0xF];
+        hi[j] = d * kvalues_iq4nl[q[j] >> 4];
+    }
+
+    dst_t * yb = yy + ib*QK4_NL + iqs;
+    *reinterpret_cast<sycl::vec<dst_t, 4> *>(yb)            = lo.convert<dst_t, sycl::rounding_mode::automatic>();
+    *reinterpret_cast<sycl::vec<dst_t, 4> *>(yb + QK4_NL/2) = hi.convert<dst_t, sycl::rounding_mode::automatic>();
+}
+
 // Dequantize Q8_0 from reorder layout: [all qs (k bytes)][all d values]
