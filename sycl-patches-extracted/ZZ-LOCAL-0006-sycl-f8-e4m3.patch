+// F8_E4M3 copies: to it from F32 / F16 / BF16 / itself, from it to F32 / F16 / BF16
+static bool ggml_sycl_cpy_f8_e4m3(const ggml_tensor * src0, const ggml_tensor * src1, const char * cx, char * cdst,
+                                  const int ne, queue_ptr stream) {
+    GGML_TENSOR_BINARY_OP_LOCALS01;
+#define GGML_SYCL_CPY_F8(kernel)                                                                                   \
+    ggml_cpy_elementwise_sycl<kernel>(cx, cdst, ne, ne00, ne01, ne02, nb00, nb01, nb02, nb03, ne10, ne11, ne12, \
+                                      nb10, nb11, nb12, nb13, stream);                                            \
+    return true
+    if (src1->type == GGML_TYPE_F8_E4M3) {
+        switch (src0->type) {
+            case GGML_TYPE_F8_E4M3: GGML_SYCL_CPY_F8(cpy_1_f8_e4m3_f8_e4m3);
+            case GGML_TYPE_F32:     GGML_SYCL_CPY_F8(cpy_1_to_f8_e4m3<float>);
+            case GGML_TYPE_F16:     GGML_SYCL_CPY_F8(cpy_1_to_f8_e4m3<sycl::half>);
+#ifdef GGML_SYCL_HAS_BF16
+            case GGML_TYPE_BF16:    GGML_SYCL_CPY_F8(cpy_1_to_f8_e4m3<sycl::ext::oneapi::bfloat16>);
+#endif
+            default:                break;
+        }
+    } else if (src0->type == GGML_TYPE_F8_E4M3) {
+        switch (src1->type) {
+            case GGML_TYPE_F32:     GGML_SYCL_CPY_F8(cpy_1_from_f8_e4m3<float>);
+            case GGML_TYPE_F16:     GGML_SYCL_CPY_F8(cpy_1_from_f8_e4m3<sycl::half>);
+#ifdef GGML_SYCL_HAS_BF16
+            case GGML_TYPE_BF16:    GGML_SYCL_CPY_F8(cpy_1_from_f8_e4m3<sycl::ext::oneapi::bfloat16>);
+#endif
+            default:                break;
+        }
+    }
+#undef GGML_SYCL_CPY_F8
+    return false;
+}
