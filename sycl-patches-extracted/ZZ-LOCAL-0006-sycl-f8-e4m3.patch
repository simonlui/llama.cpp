+// F8_E4M3 <-> F32 / F16 / BF16, through float
+template <typename src_t> static void cpy_1_to_f8_e4m3(const char * cxi, char * cdsti) {
+    *(uint8_t *) cdsti = ggml_sycl_f32_to_f8_e4m3(static_cast<float>(*(const src_t *) cxi));
+}
+
+template <typename dst_t> static void cpy_1_from_f8_e4m3(const char * cxi, char * cdsti) {
+    *(dst_t *) cdsti = static_cast<dst_t>(ggml_sycl_f8_e4m3_to_f32(*(const uint8_t *) cxi));
+}
+
+static void cpy_1_f8_e4m3_f8_e4m3(const char * cxi, char * cdsti) {
+    *cdsti = *cxi;
+}
