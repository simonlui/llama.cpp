+// OCP FP8 E4M3 (GGML_TYPE_F8_E4M3), bit-exact with ggml_f8_e4m3_to_fp32 / ggml_fp32_to_f8_e4m3 on the CPU:
+// no infinities, 0x7F and 0xFF are NaN, and conversion to FP8 saturates at +-448 and rounds to nearest even
+static __dpct_inline__ float ggml_sycl_f8_e4m3_to_f32(const uint8_t x) {
+    const uint32_t ax = x & 0x7F;
+    if (ax == 0x7F) {
+        return std::numeric_limits<float>::quiet_NaN();
+    }
+    const uint32_t e = ax >> 3;
+    const uint32_t m = ax & 7;
+    // subnormal M * 2^-9; normal (1 + M/8) * 2^(E-7), rebiased to float's exponent
+    const float    v = e == 0 ? (float) m * (1.0f / 512.0f) : sycl::bit_cast<float>(((e + 120u) << 23) | (m << 20));
+    return x & 0x80 ? -v : v;
+}
+
+static __dpct_inline__ uint8_t ggml_sycl_f32_to_f8_e4m3(const float xf) {
+    // the special cases test bits: icpx's default -fp-model=fast may fold isnan / isinf away
+    const uint32_t bits = sycl::bit_cast<uint32_t>(xf);
+    const uint8_t  sign = bits >> 31 ? 0x80 : 0;
+    const uint32_t ab   = bits & 0x7FFFFFFFu;
+    if (ab > 0x7F800000u) {  // NaN
+        return 0x7F;
+    }
+    if (ab == 0) {
+        return sign;
+    }
+    if (ab >= 0x43E00000u) {  // >= 448, infinity included: saturate
+        return sign | 0x7E;
+    }
+    if (ab < 0x3C800000u) {  // < 2^-6
+        // subnormal: M = round_to_nearest_even(x * 512); 8 becomes the smallest normal, 0x08
+        const float v = sycl::bit_cast<float>(ab) * 512.0f;
+        const float f = sycl::floor(v);
+        const float r = v - f;
+        const int   q = (int) f + ((r > 0.5f || (r == 0.5f && ((int) f & 1))) ? 1 : 0);
+        return sign | (uint8_t) q;
+    }
+    // normal: E = float exponent - 120, M = the top 3 mantissa bits rounded to nearest even
+    int            e   = (int) (ab >> 23) - 120;
+    const uint32_t man = ab & 0x7FFFFFu;
+    int            q   = (int) (man >> 20);
+    const uint32_t rem = man & 0xFFFFFu;
+    if (rem > 0x80000u || (rem == 0x80000u && (q & 1))) {
+        ++q;
+    }
+    if (q == 8) {
+        q = 0;
+        ++e;
+    }
+    if (e > 15 || (e == 15 && q > 6)) {
+        return sign | 0x7E;
+    }
+    return sign | (uint8_t) (e << 3) | (uint8_t) q;
+}
+
+// element type for the generic float converters and get_rows
+struct ggml_sycl_f8_e4m3 {
+    uint8_t bits;
+
+    operator float() const { return ggml_sycl_f8_e4m3_to_f32(bits); }
+};
