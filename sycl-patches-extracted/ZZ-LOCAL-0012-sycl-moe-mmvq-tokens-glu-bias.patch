+// ADD_ID adding a per-expert bias row to the output of mm (and nothing else)
+static bool ggml_sycl_is_moe_bias(const ggml_tensor * add_id, const ggml_tensor * mm) {
+    if (add_id->op != GGML_OP_ADD_ID || add_id->src[0] != mm || add_id->src[2] != mm->src[2]) {
+        return false;
+    }
+    const ggml_tensor * bias = add_id->src[1];
+    return add_id->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32 && bias->nb[0] == sizeof(float) &&
+           bias->ne[0] == mm->ne[0] && bias->ne[1] == mm->src[0]->ne[2] && ggml_are_same_shape(add_id, mm);
+}
+
+// gate / up MUL_MAT_IDs one MoE MMVQ launch can run together: one activation, one routing, weights of one
+// type, shape and stride
+static bool ggml_sycl_is_moe_gate_up_pair(const ggml_tensor * gate, const ggml_tensor * up) {
+    const ggml_tensor * wg = gate->src[0];
+    const ggml_tensor * wu = up->src[0];
+    return gate->op == GGML_OP_MUL_MAT_ID && up->op == GGML_OP_MUL_MAT_ID && gate->src[1] == up->src[1] &&
+           gate->src[2] == up->src[2] && wg->type == wu->type && ggml_are_same_shape(wg, wu) &&
+           wg->nb[1] == wu->nb[1] && wg->nb[2] == wu->nb[2] && ggml_is_contiguous(wg) && ggml_is_contiguous(wu) &&
+           ggml_are_same_shape(gate, up);
+}
+
+static bool ggml_sycl_moe_glu_ok(const ggml_tensor * glu, const ggml_tensor * gate_out, const ggml_tensor * up_out) {
+    return glu->op == GGML_OP_GLU && ggml_sycl_moe_mmvq_glu_supported(ggml_get_glu_op(glu)) &&
+           ggml_get_op_params_i32(glu, 1) == 0 /* not swapped */ && glu->src[0] == gate_out &&
+           glu->src[1] == up_out && glu->type == GGML_TYPE_F32 && glu->nb[0] == sizeof(float) &&
+           ggml_are_same_shape(glu, up_out);
+}
+
+bool ggml_sycl_match_moe_mmvq_fusion(const ggml_cgraph * cgraph, int i, ggml_sycl_moe_fusion_match & m) {
+    m = ggml_sycl_moe_fusion_match{};
+    if (!g_ggml_sycl_enable_fusion || cgraph->nodes[i]->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    ggml_tensor ** nodes = cgraph->nodes;
+    const int      n     = cgraph->n_nodes;
+
+    // gate + bias, up + bias, GLU (either lane first)
+    if (i + 4 < n &&
+        ggml_can_fuse_subgraph(cgraph, i,
+                               { GGML_OP_MUL_MAT_ID, GGML_OP_ADD_ID, GGML_OP_MUL_MAT_ID, GGML_OP_ADD_ID, GGML_OP_GLU },
+                               { i + 4 }) &&
+        ggml_sycl_is_moe_bias(nodes[i + 1], nodes[i]) && ggml_sycl_is_moe_bias(nodes[i + 3], nodes[i + 2])) {
+        ggml_tensor * glu   = nodes[i + 4];
+        const bool    first_is_gate = glu->src[0] == nodes[i + 1];
+        ggml_tensor * gate  = nodes[first_is_gate ? i : i + 2];
+        ggml_tensor * up    = nodes[first_is_gate ? i + 2 : i];
+        ggml_tensor * gbias = nodes[first_is_gate ? i + 1 : i + 3];
+        ggml_tensor * ubias = nodes[first_is_gate ? i + 3 : i + 1];
+        if (ggml_sycl_is_moe_gate_up_pair(gate, up) && ggml_sycl_moe_glu_ok(glu, gbias, ubias)) {
+            m = { up, gate, ubias->src[1], gbias->src[1], glu, glu, 5 };
+            return true;
+        }
+    }
+
+    // gate, up, GLU (either order)
+    if (i + 2 < n && ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT_ID, GGML_OP_MUL_MAT_ID, GGML_OP_GLU }, { i + 2 })) {
+        ggml_tensor * glu  = nodes[i + 2];
+        ggml_tensor * gate = glu->src[0];
+        ggml_tensor * up   = glu->src[1];
+        const bool    ok   = (gate == nodes[i] && up == nodes[i + 1]) || (gate == nodes[i + 1] && up == nodes[i]);
+        if (ok && ggml_sycl_is_moe_gate_up_pair(gate, up) && ggml_sycl_moe_glu_ok(glu, gate, up)) {
+            m = { up, gate, nullptr, nullptr, glu, glu, 3 };
+            return true;
+        }
+    }
+
+    // a MUL_MAT_ID and the ADD_ID of its bias
+    if (i + 1 < n && ggml_can_fuse_subgraph(cgraph, i, { GGML_OP_MUL_MAT_ID, GGML_OP_ADD_ID }, { i + 1 }) &&
+        ggml_sycl_is_moe_bias(nodes[i + 1], nodes[i]) && nodes[i + 1]->nb[0] == sizeof(float)) {
+        m = { nodes[i], nullptr, nodes[i + 1]->src[1], nullptr, nullptr, nodes[i + 1], 2 };
+        return true;
+    }
+    return false;
+}
