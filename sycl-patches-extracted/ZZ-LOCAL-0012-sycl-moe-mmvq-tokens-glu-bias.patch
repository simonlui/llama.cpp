+// The MoE FFN's MUL_MAT_IDs as one MMVQ launch each (ported from CUDA's mul_mat_vec_q fusion args):
+//   gate + up + GLU, optionally with the ADD_ID biases of both lanes:
+//     {MUL_MAT_ID, MUL_MAT_ID, GLU} or {MUL_MAT_ID, ADD_ID, MUL_MAT_ID, ADD_ID, GLU}
+//   a lone MUL_MAT_ID + ADD_ID (gpt-oss's down projection bias)
+// Returns the number of following nodes consumed, 0 if nothing was fused.
+static int ggml_sycl_mul_mat_id_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i) {
+    ggml_sycl_moe_fusion_match m;
+    if (!ggml_sycl_match_moe_mmvq_fusion(cgraph, i, m)) {
+        return 0;
+    }
+    const ggml_tensor * up   = m.up;
+    const ggml_tensor * src0 = up->src[0];
+    const ggml_tensor * src1 = up->src[1];
+    const ggml_tensor * ids  = up->src[2];
+
+    // the dense path decides the weight layout per MUL_MAT_ID; the fused kernel needs one for both lanes
+    if (ggml_backend_buffer_is_sycl_split(src0->buffer) || !ggml_sycl_mul_mat_id_mmvq_ok(up) ||
+        (m.gate && !ggml_sycl_mul_mat_id_mmvq_ok(m.gate))) {
+        return 0;
+    }
+    // the kernel reads the ids while it writes the output, which the allocator may have placed over them
+    if (ggml_sycl_ranges_overlap(m.out->data, ggml_nbytes(m.out), ids->data, ggml_nbytes(ids))) {
+        return 0;
+    }
+
+    ggml_sycl_moe_mmvq_ext ext;
+    if (m.up_bias) {
+        ext.bias        = (const float *) m.up_bias->data;
+        ext.bias_stride = m.up_bias->nb[1] / sizeof(float);
+    }
+    if (m.gate_bias) {
+        ext.gate_bias        = (const float *) m.gate_bias->data;
+        ext.gate_bias_stride = m.gate_bias->nb[1] / sizeof(float);
+    }
+    if (m.glu) {
+        ext.glu_op    = ggml_get_glu_op(m.glu);
+        ext.glu_alpha = ggml_get_op_params_f32(m.glu, 2);
+        ext.glu_limit = ggml_get_op_params_f32(m.glu, 3);
+    }
+
+    scope_op_debug_print scope_dbg_print(__func__, m.out, /*num_src=*/0,
+                                         m.glu ? " : fused MoE gate + up + GLU" : " : fused MoE mat-vec + ADD_ID");
+    if (!ggml_sycl_mul_mat_id_mmvq_launch(ctx, src0, m.gate ? m.gate->src[0] : nullptr, src1, ids,
+                                          (float *) m.out->data, m.out->nb[1], m.out->nb[2], ext)) {
+        return 0;
+    }
+    return m.node_count - 1;
