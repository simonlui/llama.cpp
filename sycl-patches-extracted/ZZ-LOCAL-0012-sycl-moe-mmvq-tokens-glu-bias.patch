+// Optional extensions of the fused MoE expert GEMV, ported from CUDA's mul_mat_vec_q with ids and fusion args:
+//  - n_tokens > 1: grid slot s is token s / n_experts_used, expert slot s % n_experts_used; the token strides step
+//    the q8_1 rows, the dst rows and the ids (ggml_sycl_mmid_mmvq_max_tokens() caps how many tokens this takes)
+//  - vgate != nullptr: dst = glu(gate . y [+ gate_bias], up . y [+ bias]) for gate / up weights of one type and
+//    layout (MUL_MAT_ID gate + MUL_MAT_ID up + GLU in one launch)
+//  - bias / gate_bias: the per-expert row bias of a following ADD_ID, bias[id * bias_stride + row]
+struct ggml_sycl_moe_mmvq_ext {
+    int           n_tokens          = 1;
+    size_t        src1_token_stride = 0;  // bytes between the q8_1 rows of consecutive tokens
+    size_t        dst_token_stride  = 0;  // bytes between the dst rows of consecutive tokens
+    size_t        ids_token_stride  = 0;  // int32 elements between the ids of consecutive tokens
+    const void *  vgate             = nullptr;
+    const float * bias              = nullptr;
+    const float * gate_bias         = nullptr;
+    size_t        bias_stride       = 0;  // floats between the bias rows of consecutive experts
+    size_t        gate_bias_stride  = 0;
+    ggml_glu_op   glu_op            = GGML_GLU_OP_SWIGLU;
+    float         glu_alpha         = 0.0f;  // SWIGLU_OAI alpha
+    float         glu_limit         = 0.0f;  // SWIGLU_OAI / SWIGLU_CLAMP limit
+    int           n_used            = 0;     // set by the launcher: expert slots per token
+};
