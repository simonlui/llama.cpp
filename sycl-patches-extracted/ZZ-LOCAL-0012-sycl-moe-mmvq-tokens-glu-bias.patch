+// GLU of the fused MoE gate + up epilogue, as the standalone GLU kernels compute it (element_wise.cpp)
+static __dpct_inline__ float ggml_sycl_moe_glu(const float gate, const float up, const ggml_sycl_moe_mmvq_ext & ext) {
+    switch (ext.glu_op) {
+        case GGML_GLU_OP_GEGLU:
+            return op_gelu(gate) * up;
+        case GGML_GLU_OP_SWIGLU_OAI: {
+            const float x = sycl::fmin(gate, ext.glu_limit);
+            const float g = sycl::fmax(sycl::fmin(up, ext.glu_limit), -ext.glu_limit);
+            return x / (1.0f + sycl::native::exp(-x * ext.glu_alpha)) * (1.0f + g);
+        }
+        case GGML_GLU_OP_SWIGLU_CLAMP: {
+            const float x = sycl::fmin(gate, ext.glu_limit);
+            const float g = sycl::fmax(sycl::fmin(up, ext.glu_limit), -ext.glu_limit);
+            return x / (1.0f + sycl::native::exp(-x)) * g;
+        }
+        default:
+            return op_silu(gate) * up;
+    }
+}
+
+// the result of one MoE output row: the ADD_ID biases and the GLU of the fused gate
+template <bool has_gate>
+static __dpct_inline__ float ggml_sycl_moe_epilogue(float up, float gate, const int i02, const int row,
+                                                    const ggml_sycl_moe_mmvq_ext & ext) {
+    if (ext.bias) {
+        up += ext.bias[(size_t) i02 * ext.bias_stride + row];
+    }
+    if constexpr (has_gate) {
+        if (ext.gate_bias) {
+            gate += ext.gate_bias[(size_t) i02 * ext.gate_bias_stride + row];
+        }
+        return ggml_sycl_moe_glu(gate, up, ext);
+    } else {
+        GGML_UNUSED(gate);
+        return up;
+    }
+}
