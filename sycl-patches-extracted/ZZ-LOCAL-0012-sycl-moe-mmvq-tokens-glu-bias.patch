+// true when [a, a + na) and [b, b + nb) share a byte
+static bool ggml_sycl_ranges_overlap(const void * a, size_t na, const void * b, size_t nb) {
+    const char * pa = (const char *) a;
+    const char * pb = (const char *) b;
+    return pa < pb + nb && pb < pa + na;
+}
