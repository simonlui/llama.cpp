+// Ternary types (TQ1_0, TQ2_0, PTQ1_0). One call covers the 32 weights of one q8_1 block: iqs is that
+// q8_1 block's index within the weight block. The trits are expanded to signed bytes for dp4a.
+#define QI_TQ1_0 (QK_K / 32)
+#define QI_TQ2_0 (QK_K / 32)
+#define VDR_TQ1_0_Q8_1_MMVQ  1
+#define VDR_TQ2_0_Q8_1_MMVQ  1
+#define VDR_PTQ1_0_Q8_1_MMVQ 1
+
+// base-3 digit n (0..4) of each packed byte of v, as packed bytes 0..2. Matches the CPU codec:
+// multiplying by 3^n mod 256 brings digit n to the top and (q * 3) >> 8 reads it. The bytes are
+// worked on in 16-bit lanes so the products do not carry into the next byte.
+static __dpct_inline__ uint32_t ternary_digits4(const uint32_t v, const int n) {
+    const uint32_t p  = n == 0 ? 1 : n == 1 ? 3 : n == 2 ? 9 : n == 3 ? 27 : 81;
+    uint32_t       lo = ((v & 0x00FF00FFu) * p) & 0x00FF00FFu;
+    uint32_t       hi = (((v >> 8) & 0x00FF00FFu) * p) & 0x00FF00FFu;
+    lo                = ((lo * 3) >> 8) & 0x00FF00FFu;
+    hi                = ((hi * 3) >> 8) & 0x00FF00FFu;
+    return lo | (hi << 8);
+}
+
+// packed digits {0, 1, 2} -> signed bytes {-1, 0, 1}; setting each byte's top bit first keeps the
+// subtraction from borrowing across bytes
+static __dpct_inline__ int ternary_to_signed4(const uint32_t t) {
+    return (int) (((t | 0x80808080u) - 0x01010101u) ^ 0x80808080u);
+}
+
+static __dpct_inline__ int ternary_dot4(const uint32_t t, const int8_t * q8, const int i32, const int sumi) {
+    return dpct::dp4a(ternary_to_signed4(t), get_int_from_int8_aligned(q8, i32), sumi);
+}
+
+// TQ2_0: q8_1 block g holds bits 2*(g%4) of qs[32*(g/4) .. 32*(g/4) + 31]
+static __dpct_inline__ float vec_dot_tq2_0_q8_1(const void * __restrict__ vbq,
+                                                const block_q8_1 * __restrict__ bq8_1, const int & iqs) {
+    const block_tq2_0 * bq    = (const block_tq2_0 *) vbq;
+    const block_q8_1 *  b8    = bq8_1 + iqs;
+    const uint8_t *     qs    = bq->qs + 32 * (iqs / 4);
+    const int           shift = 2 * (iqs % 4);
+
+    int sumi = 0;
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        sumi = ternary_dot4(((uint32_t) get_int_from_uint8(qs, k) >> shift) & 0x03030303u, b8->qs, k, sumi);
+    }
+    return (float) bq->d * (float) b8->ds[0] * (float) sumi;
+}
+
+// TQ1_0: weights 0..159 are digit w/32 of qs[w%32]; 160..239 are digit (w-160)/16 of qs[32 + (w-160)%16];
+// 240..255 are digit (w-240)/4 of qh[(w-240)%4]. So q8_1 block g < 5 is digit g of qs[0..31]; blocks 5 and 6
+// are digits 2(g-5) and 2(g-5)+1 of qs[32..47]; block 7 is digit 4 of qs[32..47], then digits 0..3 of qh.
+// Every lane runs the same 8 steps: the source bytes and the digit are selected, not branched on.
+static __dpct_inline__ float vec_dot_tq1_0_q8_1(const void * __restrict__ vbq,
+                                                const block_q8_1 * __restrict__ bq8_1, const int & iqs) {
+    const block_tq1_0 * bq = (const block_tq1_0 *) vbq;
+    const block_q8_1 *  b8 = bq8_1 + iqs;
+    const uint8_t *     x  = (const uint8_t *) bq;
+    static_assert(offsetof(block_tq1_0, qh) == 48, "qh follows the 48 qs bytes");
+
+    int sumi = 0;
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        const bool low = iqs < 5;
