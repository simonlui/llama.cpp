diff --git a/ggml/src/ggml-sycl/dequantize.hpp b/ggml/src/ggml-sycl/dequantize.hpp
index eb94771d..f33e9bf2 100644
--- a/ggml/src/ggml-sycl/dequantize.hpp
+++ b/ggml/src/ggml-sycl/dequantize.hpp
@@ -47,6 +47,66 @@ static __dpct_inline__ void dequantize_q2_0(const void *vx, const int64_t ib,
 #endif // GGML_SYCL_F16
 }
 
+// Ternary types: iqs is the weight index within the block (qr == 1). Digit n of a packed byte is
+// read as in the CPU codec: multiply by 3^n mod 256, then (q * 3) >> 8.
+static __dpct_inline__ int ternary_digit(const uint8_t b, const int n) {
+    const uint32_t p = n == 0 ? 1 : n == 1 ? 3 : n == 2 ? 9 : n == 3 ? 27 : 81;
+    return (int) ((((b * p) & 0xFFu) * 3) >> 8);
+}
+
+static __dpct_inline__ void dequantize_tq1_0(const void * vx, const int64_t ib, const int iqs, dfloat2 & v) {
+    const block_tq1_0 * x = (const block_tq1_0 *) vx + ib;
+
+    // weights 0..159: digit w/32 of qs[w%32]; 160..239: digit (w-160)/16 of qs[32 + (w-160)%16];
+    // 240..255: digit (w-240)/4 of qh[(w-240)%4]
+    auto one = [x](const int w) -> float {
+        if (w < 160) {
+            return (float) (ternary_digit(x->qs[w % 32], w / 32) - 1);
+        }
+        if (w < 240) {
+            return (float) (ternary_digit(x->qs[32 + (w - 160) % 16], (w - 160) / 16) - 1);
+        }
+        return (float) (ternary_digit(x->qh[(w - 240) % 4], (w - 240) / 4) - 1);
+    };
+
+    const float d = x->d;
+    v.x()         = one(iqs + 0) * d;
+    v.y()         = one(iqs + 1) * d;
+}
+
+static __dpct_inline__ void dequantize_tq2_0(const void * vx, const int64_t ib, const int iqs, dfloat2 & v) {
+    const block_tq2_0 * x = (const block_tq2_0 *) vx + ib;
+
+    // weight w: bits 2*((w%128)/32) of qs[32*(w/128) + w%32]
+    auto one = [x](const int w) -> float {
+        return (float) (((x->qs[32 * (w / 128) + w % 32] >> (2 * ((w % 128) / 32))) & 3) - 1);
+    };
+
+    const float d = x->d;
+    v.x()         = one(iqs + 0) * d;
+    v.y()         = one(iqs + 1) * d;
+}
+
+static __dpct_inline__ void dequantize_ptq1_0(const void * vx, const int64_t ib, const int iqs, dfloat2 & v) {
+    const block_ptq1_0 * x = (const block_ptq1_0 *) vx + ib;
+
+    // weights 0..79: digit w/16 of qs[w%16]; 80..119: digit (w-80)/8 of qs[16 + (w-80)%8];
+    // 120..127: digit (w-120)/2 of qh[(w-120)%2]
+    auto one = [x](const int w) -> float {
+        if (w < 80) {
+            return (float) (ternary_digit(x->qs[w % 16], w / 16) - 1);
+        }
+        if (w < 120) {
+            return (float) (ternary_digit(x->qs[16 + (w - 80) % 8], (w - 80) / 8) - 1);
+        }
+        return (float) (ternary_digit(x->qh[(w - 120) % 2], (w - 120) / 2) - 1);
+    };
+
+    const float d = x->d;
+    v.x()         = one(iqs + 0) * d;
+    v.y()         = one(iqs + 1) * d;
+}
