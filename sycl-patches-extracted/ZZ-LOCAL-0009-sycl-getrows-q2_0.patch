Subject: [PATCH] sycl: GET_ROWS for Q2_0

Local gap fill. Q2_0 has a SYCL dequantizer (convert, cpy) and MMVQ, but GET_ROWS did not list it,
so a Q2_0 embedding row lookup fell back to the CPU. It now runs through the generic get_rows_sycl
with the existing dequantize_q2_0 pair function.

diff --git a/ggml/src/ggml-sycl/getrows.cpp b/ggml/src/ggml-sycl/getrows.cpp
index c8430a2b..56b29d90 100644
--- a/ggml/src/ggml-sycl/getrows.cpp
+++ b/ggml/src/ggml-sycl/getrows.cpp
@@ -530,6 +530,11 @@ void ggml_sycl_op_get_rows(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
             get_rows_sycl_float(ctx, dst->src[0], dst->src[1], dst, (const ggml_sycl_f8_e4m3 *) dst->src[0]->data,
                                 src1_i32, (float *) dst->data, ctx.stream());
             break;
+        case GGML_TYPE_Q2_0:
+            get_rows_sycl<QK2_0, QR2_0, dequantize_q2_0>(ctx, dst->src[0], dst->src[1], dst,
+                                                         (const float *) dst->src[0]->data, src1_i32,
+                                                         (float *) dst->data, ctx.stream());
+            break;
         case GGML_TYPE_Q1_0:
             get_rows_sycl<QK1_0, 1, dequantize_q1_0>(ctx, dst->src[0], dst->src[1], dst, (const float *)dst->src[0]->data,
             src1_i32, (float *)dst->data, ctx.stream());
diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index d1ed0e28..6524b78e 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -7642,6 +7642,7 @@ static bool do_ggml_backend_sycl_device_supports_op(ggml_backend_dev_t dev, cons
                     case GGML_TYPE_F32:
                     case GGML_TYPE_F8_E4M3:
                     case GGML_TYPE_Q1_0:
+                    case GGML_TYPE_Q2_0:
                     case GGML_TYPE_MXFP4:
                     case GGML_TYPE_NVFP4:
                     case GGML_TYPE_TQ1_0:
