Subject: [PATCH] sycl: reorder Q4_0, Q2_K and Q3_K MoE expert weights for the fused MoE MMVQ

Local gap fill. The 2D reorder (SoA) MMVQ covers Q4_0, Q2_K and Q3_K, but MUL_MAT_ID only reordered
Q8_0, Q4_K, Q5_K, Q6_K and MXFP4 experts, so the fused MoE decode read these three in the block
layout. reorder_qw_planar_moe() gives every expert slice the self-contained layout the 2D reorder
gives a matrix (a few experts at a time through a small temporary, as reorder_qw_q4_k_moe), and the
generic MoE reorder MMVQ runs the 2D reorder dot products per slice. The 2D and the per-expert
reorder share one tail writer per type, so they cannot drift apart.

Readers of a reordered expert tensor, all already reorder-aware for these types: the per-expert
prompt loop (2D MMVQ, DMMV, ESIMD and dequantize per slice), the grouped dequant GEMM (fg_soa has
Q2_K and Q3_K; Q4_0 has no grouped stage) and candidate C20/C21's ESIMD MoE GEMM (q2_K to q6_K in
either layout). IQ3_XXS / IQ3_S are left out: the grouped GEMM has no SoA stage for them, so
reordering would move their MoE prefill to the per-expert loop. Slices that are not 16-byte aligned
stay in the block layout.

diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index 40b005e0..5a32b657 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -4646,14 +4646,93 @@ static bool reorder_qw_planar(const char * name, uint8_t * data_device, size_t s
     return true;
 }
 
+// Tail writers of the planar reorder, shared by the 2D reorder and the per-expert one below so both write one layout.
+struct reorder_tail_q4_0 {
+    void operator()(const block_q4_0 & x, int64_t ib, uint8_t * tail, int64_t) const {
+        ((sycl::half *) tail)[ib] = x.d;
+    }
+};
+
+struct reorder_tail_q2_k {
+    void operator()(const block_q2_K & x, int64_t ib, uint8_t * tail, int64_t nblocks) const {
+        uint8_t * scales = tail;
+        for (int j = 0; j < QK_K / 16; ++j) {
+            scales[ib * (QK_K / 16) + j] = x.scales[j];
+        }
+        ((sycl::half2 *) (scales + (QK_K / 16) * nblocks))[ib] = x.dm;
+    }
+};
+
+struct reorder_tail_q3_k {
+    void operator()(const block_q3_K & x, int64_t ib, uint8_t * tail, int64_t nblocks) const {
+        uint8_t * hmask  = tail;
+        uint8_t * scales = hmask + (QK_K / 8) * nblocks;
+        for (int j = 0; j < QK_K / 8; ++j) {
+            hmask[ib * (QK_K / 8) + j] = x.hmask[j];
+        }
+        for (int j = 0; j < 12; ++j) {
+            scales[ib * 12 + j] = x.scales[j];
+        }
+        ((sycl::half *) (scales + 12 * nblocks))[ib] = x.d;
+    }
+};
+
+// reorder_qw_planar for MoE expert weights: every expert slice of expert_bytes becomes the self-contained layout the
+// 2D reorder gives a matrix, so the 2D readers (MMVQ, DMMV, dequantize, the grouped GEMM's SoA stage) work per slice.
+// A few experts at a time through a small temporary, as reorder_qw_q4_k_moe.
+template <typename block_t, typename F>
+static bool reorder_qw_planar_moe(const char * name, uint8_t * data_device, size_t expert_bytes, int64_t n_expert,
+                                  size_t head_offset, size_t head_bytes, F write_tail, dpct::queue_ptr stream) {
+    GGML_ASSERT(expert_bytes % sizeof(block_t) == 0);
+    GGML_ASSERT(head_offset + head_bytes <= sizeof(block_t));
+    const int64_t blocks_per_expert = expert_bytes / sizeof(block_t);
+    const size_t  max_chunk_bytes   = 32u << 20;
+    const int64_t chunk_experts =
+        std::max<int64_t>(1, std::min<int64_t>(n_expert, (int64_t) (max_chunk_bytes / expert_bytes)));
+
+    sycl_reorder_temp_buffer tmp(stream, (size_t) chunk_experts * expert_bytes);
+    if (!tmp) {
+        GGML_LOG_WARN("%s: failed to allocate %zu bytes for reorder temp buffer, skipping reorder\n", name,
+                      (size_t) chunk_experts * expert_bytes);
+        return false;
+    }
+    uint8_t * tmp_buf = static_cast<uint8_t *>(tmp.ptr);
+
+    // the queue is in-order: each chunk's copy into tmp_buf waits for the previous chunk's kernel
+    for (int64_t e0 = 0; e0 < n_expert; e0 += chunk_experts) {
+        const int64_t n_chunk = std::min(chunk_experts, n_expert - e0);
+        uint8_t *     chunk   = data_device + (size_t) e0 * expert_bytes;
+
+        sycl::event event;
+        SYCL_CHECK(CHECK_TRY_ERROR(event = stream->memcpy(tmp_buf, chunk, (size_t) n_chunk * expert_bytes)));
+        if (!g_ggml_sycl_use_async_mem_op) {
+            event.wait();
+        }
+        event = stream->parallel_for(n_chunk * blocks_per_expert, [=](auto i) {
+            const int64_t   gb   = i;
+            const int64_t   e    = gb / blocks_per_expert;
+            const int64_t   ib   = gb % blocks_per_expert;
+            const block_t & x    = ((const block_t *) (tmp_buf + (size_t) e * expert_bytes))[ib];
+            uint8_t *       base = chunk + (size_t) e * expert_bytes;
+            const uint8_t * src  = (const uint8_t *) &x + head_offset;
+            for (size_t j = 0; j < head_bytes; ++j) {
+                base[ib * head_bytes + j] = src[j];
+            }
+            write_tail(x, ib, base + head_bytes * blocks_per_expert, blocks_per_expert);
+        });
+        if (!g_ggml_sycl_use_async_mem_op) {
+            event.wait_and_throw();
+        }
+    }
+    return true;
+}
+
 static bool reorder_qw_q4_0(uint8_t * data_device, const int ncols, const int nrows, size_t size, size_t offset,
                             dpct::queue_ptr stream) {
     GGML_ASSERT(offset == 0);
     GGML_ASSERT((size_t) ncols * nrows / 2 == size / sizeof(block_q4_0) * (QK4_0 / 2));
     return reorder_qw_planar<block_q4_0>(__func__, data_device, size, offsetof(block_q4_0, qs), QK4_0 / 2,
-        [](const block_q4_0 & x, int64_t ib, uint8_t * tail, int64_t) {
-            ((sycl::half *) tail)[ib] = x.d;
-        }, stream);
+                                         reorder_tail_q4_0{}, stream);
 }
 
 static bool reorder_qw_q8_0(uint8_t * data_device, const int ncols, const int nrows, size_t size, size_t offset,
@@ -4948,29 +5027,13 @@ static bool reorder_qw_mxfp4_moe(uint8_t * data_device, size_t expert_bytes, int
 static bool reorder_qw_q2_k(uint8_t * data_device, size_t size, size_t offset, dpct::queue_ptr stream) {
     GGML_ASSERT(offset == 0);
     return reorder_qw_planar<block_q2_K>(__func__, data_device, size, offsetof(block_q2_K, qs), QK_K / 4,
-        [](const block_q2_K & x, int64_t ib, uint8_t * tail, int64_t nblocks) {
-            uint8_t * scales = tail;
-            for (int j = 0; j < QK_K / 16; ++j) {
-                scales[ib * (QK_K / 16) + j] = x.scales[j];
-            }
-            ((sycl::half2 *) (scales + (QK_K / 16) * nblocks))[ib] = x.dm;
-        }, stream);
+                                         reorder_tail_q2_k{}, stream);
 }
 
 static bool reorder_qw_q3_k(uint8_t * data_device, size_t size, size_t offset, dpct::queue_ptr stream) {
     GGML_ASSERT(offset == 0);
     return reorder_qw_planar<block_q3_K>(__func__, data_device, size, offsetof(block_q3_K, qs), QK_K / 4,
-        [](const block_q3_K & x, int64_t ib, uint8_t * tail, int64_t nblocks) {
-            uint8_t * hmask  = tail;
-            uint8_t * scales = hmask + (QK_K / 8) * nblocks;
-            for (int j = 0; j < QK_K / 8; ++j) {
-                hmask[ib * (QK_K / 8) + j] = x.hmask[j];
-            }
-            for (int j = 0; j < 12; ++j) {
-                scales[ib * 12 + j] = x.scales[j];
-            }
-            ((sycl::half *) (scales + 12 * nblocks))[ib] = x.d;
-        }, stream);
+                                         reorder_tail_q3_k{}, stream);
 }
 
 static bool reorder_qw_q5_k(uint8_t * data_device, size_t size, size_t offset, dpct::queue_ptr stream) {
@@ -5052,6 +5115,18 @@ static bool reorder_qw(const ggml_tensor * src0, dpct::queue_ptr stream) {
                 return reorder_qw_q6_k_moe(data_device, src0->nb[2], src0->ne[2], stream);
             case GGML_TYPE_MXFP4:
                 return reorder_qw_mxfp4_moe(data_device, src0->nb[2], src0->ne[2], stream);
+            case GGML_TYPE_Q4_0:
+                return reorder_qw_planar_moe<block_q4_0>("reorder_qw_q4_0_moe", data_device, src0->nb[2], src0->ne[2],
+                                                         offsetof(block_q4_0, qs), QK4_0 / 2, reorder_tail_q4_0{},
+                                                         stream);
+            case GGML_TYPE_Q2_K:
+                return reorder_qw_planar_moe<block_q2_K>("reorder_qw_q2_k_moe", data_device, src0->nb[2], src0->ne[2],
+                                                         offsetof(block_q2_K, qs), QK_K / 4, reorder_tail_q2_k{},
+                                                         stream);
+            case GGML_TYPE_Q3_K:
+                return reorder_qw_planar_moe<block_q3_K>("reorder_qw_q3_k_moe", data_device, src0->nb[2], src0->ne[2],
+                                                         offsetof(block_q3_K, qs), QK_K / 4, reorder_tail_q3_k{},
+                                                         stream);
             default:
                 return false;
         }
@@ -5130,7 +5205,14 @@ static void opt_for_reorder_id(ggml_backend_sycl_context * ctx, const ggml_tenso
         return;
     }
     if (src0->type != GGML_TYPE_Q8_0 && src0->type != GGML_TYPE_Q4_K &&
-        src0->type != GGML_TYPE_Q5_K && src0->type != GGML_TYPE_Q6_K && src0->type != GGML_TYPE_MXFP4) {
+        src0->type != GGML_TYPE_Q5_K && src0->type != GGML_TYPE_Q6_K && src0->type != GGML_TYPE_MXFP4 &&
+        src0->type != GGML_TYPE_Q4_0 && src0->type != GGML_TYPE_Q2_K && src0->type != GGML_TYPE_Q3_K) {
+        return;
+    }
+    // Q4_0 / Q2_K / Q3_K experts take the 2D readers per slice, some with vector loads sized for a 2D tensor's
+    // aligned start: keep every slice 16-byte aligned, else stay in the block layout
+    if ((src0->type == GGML_TYPE_Q4_0 || src0->type == GGML_TYPE_Q2_K || src0->type == GGML_TYPE_Q3_K) &&
+        (src0->nb[2] % 16 != 0 || (uintptr_t) src0->data % 16 != 0)) {
         return;
     }
     // The MXFP4 reorder kernels use 8-byte vector loads, so every expert slice must stay aligned.
diff --git a/ggml/src/ggml-sycl/mmvq.cpp b/ggml/src/ggml-sycl/mmvq.cpp
index ae59d815..be534812 100644
--- a/ggml/src/ggml-sycl/mmvq.cpp
+++ b/ggml/src/ggml-sycl/mmvq.cpp
@@ -2821,6 +2821,9 @@ bool ggml_sycl_mul_mat_vec_q_id_supports_type(enum ggml_type src0_type) {
 
 bool ggml_sycl_mul_mat_vec_q_id_reorder_supports_type(enum ggml_type src0_type) {
     switch (src0_type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
         case GGML_TYPE_Q8_0:
         case GGML_TYPE_Q4_K:
         case GGML_TYPE_Q5_K:
@@ -3109,6 +3112,22 @@ bool ggml_sycl_mul_mat_vec_q_id_reorder(
                 vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
                 expert_weight_stride, dst_row_stride, src1_row_stride, stream);
             return true;
+        // each expert slice holds the 2D reorder layout (reorder_qw_planar_moe), which the 2D dot products read
+        case GGML_TYPE_Q4_0:
+            launch_mul_mat_vec_q_moe_reorder<reorder_vec_dot_q_sycl<GGML_TYPE_Q4_0>>(
+                vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
+                expert_weight_stride, dst_row_stride, src1_row_stride, stream);
+            return true;
+        case GGML_TYPE_Q2_K:
+            launch_mul_mat_vec_q_moe_reorder<reorder_vec_dot_q_sycl<GGML_TYPE_Q2_K>>(
+                vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
+                expert_weight_stride, dst_row_stride, src1_row_stride, stream);
+            return true;
+        case GGML_TYPE_Q3_K:
+            launch_mul_mat_vec_q_moe_reorder<reorder_vec_dot_q_sycl<GGML_TYPE_Q3_K>>(
+                vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used,
+                expert_weight_stride, dst_row_stride, src1_row_stride, stream);
+            return true;
         default:
             return false;
     }
