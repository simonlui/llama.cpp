diff --git a/ggml/src/ggml-sycl/fused-elementwise.cpp b/ggml/src/ggml-sycl/fused-elementwise.cpp
new file mode 100644
index 00000000..3a4bb37b
--- /dev/null
+++ b/ggml/src/ggml-sycl/fused-elementwise.cpp
@@ -0,0 +1,99 @@
+#include "fused-elementwise.hpp"
+
+static constexpr int GGML_SYCL_FUSED_EW_BLOCK = 256;
+
+static sycl::nd_range<1> fused_ew_range(int64_t n) {
+    const int64_t n_blocks = (n + GGML_SYCL_FUSED_EW_BLOCK - 1) / GGML_SYCL_FUSED_EW_BLOCK;
+    return sycl::nd_range<1>(sycl::range<1>(n_blocks * GGML_SYCL_FUSED_EW_BLOCK),
+                             sycl::range<1>(GGML_SYCL_FUSED_EW_BLOCK));
+}
+
+void ggml_sycl_op_softcap(ggml_backend_sycl_context & ctx, ggml_tensor * dst, const ggml_tensor * scale_in) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/0, " : fused scale + tanh + scale");
+    const ggml_tensor * src = scale_in->src[0];
+    GGML_ASSERT(src->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+
+    const float   scale   = ggml_get_op_params_f32(scale_in, 0);
+    const float   softcap = ggml_get_op_params_f32(dst, 0);
+    const float * x       = (const float *) src->data;
+    float *       y       = (float *) dst->data;
+    const int64_t n       = ggml_nelements(src);
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    stream->parallel_for(fused_ew_range(n), [=](sycl::nd_item<1> it) {
+        const int64_t i = it.get_global_id(0);
+        if (i < n) {
+            y[i] = sycl::tanh(scale * x[i]) * softcap;
+        }
+    });
+}
+
+template <typename T>
+static void relu_sqr_sycl(const T * x, T * y, const int64_t n, dpct::queue_ptr stream) {
+    stream->parallel_for(fused_ew_range(n), [=](sycl::nd_item<1> it) {
+        const int64_t i = it.get_global_id(0);
+        if (i < n) {
+            const float r = sycl::fmax((float) x[i], 0.0f);
+            y[i]          = (T) (r * r);
+        }
+    });
+}
+
+void ggml_sycl_op_relu_sqr(ggml_backend_sycl_context & ctx, const ggml_tensor * relu, ggml_tensor * sqr) {
+    scope_op_debug_print scope_dbg_print(__func__, sqr, /*num_src=*/0, " : fused relu + sqr");
+    const ggml_tensor * src = relu->src[0];
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(sqr) && src->type == sqr->type);
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    if (src->type == GGML_TYPE_F16) {
+        relu_sqr_sycl((const sycl::half *) src->data, (sycl::half *) sqr->data, ggml_nelements(src), stream);
+    } else {
+        GGML_ASSERT(src->type == GGML_TYPE_F32);
+        relu_sqr_sycl((const float *) src->data, (float *) sqr->data, ggml_nelements(src), stream);
+    }
+}
+
+template <typename T>
+static void snake_sycl(const T * x, const float * a, const float * inv_b, T * dst, const int64_t T_len,
+                       const int64_t total, dpct::queue_ptr stream) {
+    stream->parallel_for(fused_ew_range(total), [=](sycl::nd_item<1> it) {
+        const int64_t idx = it.get_global_id(0);
+        if (idx >= total) {
+            return;
+        }
+        const int64_t c  = idx / T_len;
+        const float   xi = (float) x[idx];
+        const float   s  = sycl::sin(a[c] * xi);
+        dst[idx]         = (T) (xi + s * s * inv_b[c]);
+    });
+}
+
+void ggml_sycl_op_snake(ggml_backend_sycl_context & ctx, const ggml_tensor * x, const ggml_tensor * a,
+                        const ggml_tensor * inv_b, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/0, " : fused snake activation");
+    const int64_t T     = x->ne[0];
+    const int64_t total = T * x->ne[1];
+    const float * a_d   = (const float *) a->data;
+    const float * b_d   = (const float *) inv_b->data;
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+    switch (x->type) {
+        case GGML_TYPE_F32:
+            snake_sycl((const float *) x->data, a_d, b_d, (float *) dst->data, T, total, stream);
+            break;
+        case GGML_TYPE_F16:
+            snake_sycl((const sycl::half *) x->data, a_d, b_d, (sycl::half *) dst->data, T, total, stream);
+            break;
+#ifdef GGML_SYCL_HAS_BF16
+        case GGML_TYPE_BF16:
+            snake_sycl((const sycl::ext::oneapi::bfloat16 *) x->data, a_d, b_d,
+                       (sycl::ext::oneapi::bfloat16 *) dst->data, T, total, stream);
+            break;
+#endif
+        default:
+            GGML_ABORT("snake: unsupported type");
+    }
+}
