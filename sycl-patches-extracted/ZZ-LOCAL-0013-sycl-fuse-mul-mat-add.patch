+    void * mm_data      = mm->data;
+    mm->data            = add->data;
+    ctx.mmv_add         = (const float *) addend->data;
+    ctx.mmv_add_applied = false;
+    ggml_sycl_mul_mat(ctx, mm->src[0], mm->src[1], mm);
+    const bool applied  = ctx.mmv_add_applied;
+    ctx.mmv_add         = nullptr;
+    ctx.mmv_add_applied = false;
+
+    GGML_SYCL_DEBUG("[SYCL] %s: %s\n", __func__,
+                    applied ? "ADD folded into the mat-vec store" : "mat-vec without the epilogue, ADD in place");
+    if (!applied) {
+        // the plain mat-vec result is in the ADD's memory: add the addend in place
+        ggml_tensor mm_out          = *mm;
+        ggml_tensor add_node        = *add;
+        add_node.src[mm_src]        = &mm_out;
+        ggml_sycl_add(ctx, &add_node);
+    }
+    mm->data = mm_data;
+    return true;
+}
