+// MUL_MAT of one activation column + ADD (the residual after the attention output and the FFN down projection,
+// or a bias), ported from the CUDA / Vulkan / Metal mul_mat + add fusions. The mat-vec writes straight into the
+// ADD's memory and the DMMV kernels add the addend in their store; a kernel that does not take it leaves its plain
+// result there, and an in-place ADD finishes the job, so the fusion never costs a launch.
+static bool ggml_sycl_mul_mat_add_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (!ggml_sycl_match_mul_mat_add(cgraph, i)) {
+        return false;
+    }
+    ggml_tensor *       mm     = cgraph->nodes[i];
+    ggml_tensor *       add    = cgraph->nodes[i + 1];
+    const int           mm_src = add->src[0] == mm ? 0 : 1;
+    const ggml_tensor * addend = add->src[1 - mm_src];
+
+    // the row slices of split weights are stitched together elsewhere
+    if (ggml_backend_buffer_is_sycl_split(mm->src[0]->buffer)) {
+        return false;
+    }
+    // the mat-vec reads its activation while it writes the ADD's memory, and the fallback would overwrite the
+    // addend before reading it: either overlap declines (graph_optimize keeps the activation alive to avoid it)
+    const auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const char * pa = (const char *) a->data;
+        const char * pb = (const char *) b->data;
+        return pa < pb + ggml_nbytes(b) && pb < pa + ggml_nbytes(a);
+    };
