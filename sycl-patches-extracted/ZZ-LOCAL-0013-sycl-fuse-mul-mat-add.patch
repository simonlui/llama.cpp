+// plain mat-vec with a fused residual / bias ADD (ggml_sycl_mul_mat_add_fused): dst = sum + add. Its own policy,
+// and the addend gathered, because IGC's ESIMD back end (acm-g10, oneAPI 2026.2) crashes on a load from it
+// behind a run-time null check.
+struct esimd_dmmv_row_pair_add_policy : esimd_dmmv_row_pair_policy {
+    const float * add;
+
+    ESIMD_INLINE void epilogue(int g, int nrows, float sum_a, float sum_b) const {
+        using namespace sycl::ext::intel::esimd;
+
+        simd<uint32_t, 2> offs;
+        offs[0] = (uint32_t) row_a(g) * sizeof(float);
+        offs[1] = (uint32_t) (has_b(g, nrows) ? row_b(g) : row_a(g)) * sizeof(float);
+        const simd<float, 2> a = gather<float, 2>(add, offs);
+        esimd_dmmv_row_pair_policy::epilogue(g, nrows, sum_a + a[0], sum_b + a[1]);
+    }
+};
+
 // fused gate+up+GLU: a work-group owns one row of both matrices; a is the gate, b the up
